{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/tap-runner"],
  "testRunner": "tap",
  "coverageAnalysis": "perTest",
  "concurrency": "50%",
  "timeoutFactor": 3,
  "mutate": [
    "core-shared--publisher-issuer/bind.js",
    "core-shared/names.js",
    "core-shared/periodLabels.js",
    "core-shared/codec.js"
  ],
  "tap": {
    "nodeArgs": ["--test", "--experimental-test-isolation=none", "{{testFile}}"],
    "testFiles": [
      "test-base/import-boundary.test.js",
      "test-reference/adapter-client/periodkeys.test.js",
      "test-reference/core-publisher/sealer-composition.test.js",
      "test-reference/core-publisher/site-resource-plan.test.js",
      "test-reference/core-shared/aead.test.js",
      "test-reference/core-shared/binary-strings.test.js",
      "test-reference/core-shared/codec.test.js",
      "test-reference/core-shared/crypto-provider.test.js",
      "test-reference/core-shared/keySealing.test.js",
      "test-reference/core-shared/names.test.js",
      "test-reference/core-shared/shared-primitive-misuse.test.js",
      "test/actors.test.js",
      "test/bind.test.js",
      "test/browser-origin-boundary.test.js",
      "test/cache-eviction.test.js",
      "test/clock-skew.test.js",
      "test/content-key-resolver.test.js",
      "test/dca-data.test.js",
      "test/dca-request-builder.test.js",
      "test/endpoint-port-hardening.test.js",
      "test/invalid-curve-point.test.js",
      "test/issuer-ordinary-baseline.test.js",
      "test/issuer-processor.test.js",
      "test/issuer-walk.test.js",
      "test/jwt-proof.test.js",
      "test/leak-checks.test.js",
      "test/markup-load.test.js",
      "test/markup-writer.test.js",
      "test/open-content.test.js",
      "test/period-prefix.test.js",
      "test/resource-tamper.test.js",
      "test/rotation.test.js",
      "test/seal-unseal-decrypt.test.js",
      "test/sealer-direct-only.test.js",
      "test/sealer-names.test.js",
      "test/storage-concurrency.test.js",
      "test/time.test.js",
      "test/transport.test.js",
      "test/wire-lookup-client.test.js",
      "test/wire-lookup-endpoint.test.js",
      "test/wire-policy-adapter-client.test.js",
      "test/wire-policy.test.js"
    ]
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
