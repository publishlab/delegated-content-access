#!/bin/sh
# Run the public JavaScript gate for this demo.
#
#     sh check
#
# This forwards to `pnpm run check` in js. The install steps in
# js/README.md use pnpm. The stages and rules live in
# js/test-tools/run-gate.js.
#
# Exit codes:
#   0  every required public-gate stage held
#   1  a required stage ran and failed
#   2  a required stage could not run or verified less than it set out to

cd "$(dirname "$0")" || exit 2
if ! command -v pnpm >/dev/null 2>&1; then
    printf '%s\n' 'Cannot run JavaScript checks: pnpm is not available on PATH.' >&2
    printf '%s\n' 'Use the pinned Node and pnpm versions; see js/README.md for setup.' >&2
    exit 2
fi
exec pnpm run check
