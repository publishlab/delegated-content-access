{
  "name": "dca-reference",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15 <23 || >=24.19 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.0.0",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "mutate": "command -v ps >/dev/null || { echo \"stryker needs ps (procps) on PATH\" >&2; exit 1; } && stryker run",
    "mutate:issuer": "command -v ps >/dev/null || { echo \"stryker needs ps (procps) on PATH\" >&2; exit 1; } && stryker run stryker.issuer.config.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node test-tools/run-gate.js",
    "claim:all": "node test-tools/run-claim-index.js --all",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test-tools/test-verdict-reporter.mjs --test-reporter-destination=stderr \"!(experiments|test-contract)/**/*.test.js\"",
    "test:single-process": "DCA_NODE_TEST_ISOLATION=none npm test",
    "test:all": "npm run test && npm run test:experiments",
    "check:types": "tsc -p jsconfig.json --pretty false",
    "check:consumer-types": "tsc -p test-reference/tsconfig.types.json --pretty false",
    "check:consumer-declarations": "node test-tools/check-consumer-declarations.mjs",
    "typecheck": "tsc -p jsconfig.json --pretty false",
    "check:boundaries": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"test-base/*.test.js\"",
    "test:reference:public": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test --test-reporter=tap \"test/**/*.test.js\" \"test-reference/**/*.test.js\" \"extensions/*/test/**/*.test.js\" \"test-extensions/*.test.js\" \"test-profiles/*.test.js\"",
    "test:reference:base": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"test/**/*.test.js\" \"test-reference/**/*.test.js\"",
    "test:reference:extension:content-key-seal-omission": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/content-key-seal-omission/test/**/*.test.js\"",
    "test:reference:extension:content-groups": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/content-groups/test/**/*.test.js\"",
    "test:reference:extension:content-compression": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/content-compression/test/**/*.test.js\"",
    "test:reference:extension:chain-keys": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/chain-keys/test/**/*.test.js\"",
    "test:reference:extension:client-bound-transport": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/client-bound-transport/test/**/*.test.js\"",
    "test:reference:extension:recipient-grant": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/recipient-grant/test/**/*.test.js\"",
    "test:reference:extension:content-description": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/content-description/test/**/*.test.js\"",
    "test:reference:extension:html-content-map": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/html-content-map/test/**/*.test.js\"",
    "test:reference:extension:compact-ecdh": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/compact-ecdh/test/**/*.test.js\"",
    "test:reference:extension:nonce-free-envelope": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/nonce-free-envelope/test/**/*.test.js\"",
    "test:reference:extension:nonce-free-response": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"extensions/nonce-free-response/test/**/*.test.js\"",
    "test:reference:compositions": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"test-extensions/*.test.js\"",
    "test:reference:profiles": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"test-profiles/*.test.js\"",
    "test:reference:vectors": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"test-vectors/*.test.js\"",
    "test:tools": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test \"test-tools/*.test.js\"",
    "test:reference:actors": "node test-reference/run-reference-target.js actors",
    "test:reference:adapter-client": "node test-reference/run-reference-target.js adapter-client",
    "test:reference:adapter-issuer": "node test-reference/run-reference-target.js adapter-issuer",
    "test:reference:adapter-publisher": "node test-reference/run-reference-target.js adapter-publisher",
    "test:reference:client-core": "node test-reference/run-reference-target.js client-core",
    "test:reference:core-shared": "node test-reference/run-reference-target.js core-shared",
    "test:reference:core-shared:extracted": "node --test \"test-reference/core-shared/*.test.js\"",
    "test:reference:environment": "node test-reference/run-reference-target.js environment",
    "test:reference:integration-client": "node test-reference/run-reference-target.js integration-client",
    "test:reference:integration-issuer": "node test-reference/run-reference-target.js integration-issuer",
    "test:reference:integration-publisher": "node test-reference/run-reference-target.js integration-publisher",
    "test:reference:issuer-core": "node test-reference/run-reference-target.js issuer-core",
    "test:reference:issuer-endpoint": "node test-reference/run-reference-target.js issuer-endpoint",
    "test:reference:layout": "node test-reference/run-reference-target.js layout",
    "test:reference:ports": "node test-reference/run-reference-target.js ports",
    "test:reference:publisher-core": "node test-reference/run-reference-target.js publisher-core",
    "test:bridge": "node test-bridges/_shared/run.mjs",
    "test:reference:system": "node test-reference/run-reference-target.js system",
    "test:experiments": "node --test \"experiments/*/test/*.test.js\"",
    "test:contract": "node --experimental-test-isolation=\"${DCA_NODE_TEST_ISOLATION:-process}\" --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test-tools/test-verdict-reporter.mjs --test-reporter-destination=stderr test-contract/contract-runner-validation.test.js && npm run test:contract:reference:base && npm run test:contract:fixture:issuer-endpoint && npm run test:contract:reference:issuer-browser-origin && npm run test:contract:reference:html-writer",
    "test:contract:base": "node test-contract/run-contract-target.js",
    "test:contract:reference:base": "npm run test:contract:base -- test-contract/bindings/reference-base-binding.js",
    "test:contract:fixture:issuer-endpoint": "npm run test:contract:issuer-endpoint -- test-contract/issuer-endpoint/bindings/fixture-issuer-endpoint-binding.js",
    "test:contract:issuer-endpoint": "node test-contract/run-contract-target.js",
    "test:contract:issuer-core": "node test-contract/run-contract-target.js",
    "test:contract:issuer-browser-origin": "node test-contract/run-contract-target.js",
    "test:contract:reference:issuer-browser-origin": "npm run test:contract:issuer-browser-origin -- test-contract/issuer-browser-origin/bindings/reference-issuer-browser-origin-binding.js",
    "claim:evidence": "node test-tools/run-claim-index.js",
    "test:contract:html-writer": "node test-contract/run-contract-target.js",
    "test:contract:reference:html-writer": "npm run test:contract:html-writer -- test-contract/html-writer/bindings/reference-html-writer-binding.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "puppeteer-core": "25.10.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "parse5": "8.0.1"
  }
}
