#!/usr/bin/env bash
# Make the .NET bridge runnable, before anything is asked of it.
#
# The runner names this as the dotnet entry's preparation step, which runs outside the
# request's time. Restoring, compiling and warming a runtime inside the batch would
# measure the compiler and report the answer as the bridge's speed.
#
# It publishes conformance-primitives/dotnet/bcl/v1/bridge into the lane's cache dir and then asks the
# published program an empty batch. This script publishes here for that last step: a
# program that cannot start says so now, with the exit code that makes the run
# incomplete, rather than at the moment the batch is written to its stdin.
#
# It needs network only for the first toolchain install, which install-toolchain
# does and this script only calls. The project names no PackageReference, so its
# restore reads the SDK and never the network.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=paths.sh
. "$HERE/paths.sh"
resolve_bridge_paths "$HERE"

# The installer is idempotent and prints BASE on stdout. Called without a print query,
# so a cold cache installs rather than reporting a path that is not there yet.
if ! BASE="$("$HERE/../../../install-toolchain" --version "$DOTNET_VERSION_TOKEN")"; then
    echo "no .NET SDK, so the bridge was not built." >&2
    exit 2
fi

mkdir -p "$BRIDGE_OUT"

# The cache dir is shared: $HOME is a bind mount several concurrent runs see at once,
# and two runs from this same tree publish to this same directory. One exclusive lock
# covers the publish, so a second caller waits rather than executing an assembly that
# is halfway written.
exec 9>"$BRIDGE_OUT/.build.lock"
flock 9

# VBCSCompiler (the Roslyn compiler server) and the MSBuild server node are the SDK's
# persistent build daemons: a publish spawns one to speed up the next build, and it
# outlives this script. A daemon spawned after the exec above inherits fd 9 as an open
# duplicate: bash does not mark it close-on-exec, and dotnet does not close inherited
# fds either, so it keeps .build.lock's flock held long after this process exits and
# releases its own fd 9. The next prepare then blocks in `flock 9` until the driver's
# prepareBridge timeout fires and the lane reports incomplete. This script fixes that by disabling both daemons
# for this hermetic, no-PackageReference build; closing fd 9 for the publish
# command itself (9>&- below) means no descendant can inherit it even if a future SDK
# starts a daemon some other property does not cover.
export DOTNET_CLI_USE_MSBUILD_SERVER=0

echo "== dotnet publish -> $BRIDGE_OUT ==" >&2
"$BASE/dotnet" publish "$HERE/bridge.csproj" \
    --artifacts-path "$BRIDGE_OUT/artifacts" \
    -o "$BRIDGE_OUT/app" \
    -p:UseSharedCompilation=false \
    --nologo -v quiet \
    9>&-

# An empty batch is a whole valid batch, so this asks the published program the
# smallest real question there is: it loads the runtime, parses an envelope, writes an
# empty results array and exits 0. A JIT that has run once answers the timed batch
# faster, and a program that cannot start fails here where the failure is a build
# problem rather than a bridge that did not answer.
echo "== warmup, one empty batch ==" >&2
printf '%s\n' '{"protocol":"dca-operation-bridge-v1","requests":[]}' | "$HERE/start" >/dev/null
