<Project Sdk="Microsoft.NET.Sdk">

  <!-- The whole build definition for the operation bridge. The build is written in the ecosystem's
       own project file rather than an added build tool, and this one sits in
       its own directory so the default .cs glob covers this program alone:
       `Primitives.cs` and `Json.cs` a directory up come in explicitly below rather
       than through that glob. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bridge</AssemblyName>
    <RootNamespace>Bridge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- No PackageReference anywhere. System.Text.Json, System.Buffers.Text and
       System.Security.Cryptography provide every library call this bridge makes, so a
       restore reads the SDK and never the network. -->

  <!-- Bridge.cs calls ../Primitives.cs for every library call it answers with, so
       this project compiles that file directly rather than repeating the calls.
       Json.cs comes with it: the JWK-import methods in Primitives.cs take the ordered
       object model that file defines, and Bridge.cs turns a parsed System.Text.Json
       JsonElement into one with Json.TryParseObject rather than adding a second JWK
       reader. Each project directory globs only itself, so neither file's own default
       glob reaches here and both are named. -->
  <ItemGroup>
    <Compile Include="../Primitives.cs" Link="Primitives.cs" />
    <Compile Include="../Json.cs" Link="Json.cs" />
  </ItemGroup>

</Project>
