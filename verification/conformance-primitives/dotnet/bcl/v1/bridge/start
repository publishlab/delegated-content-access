#!/usr/bin/env bash
# Start the published .NET bridge, and add nothing to what it says.
#
# The runner starts this file as the dotnet bridge's command. It exists because the
# SDK lives in a cache dir and is never put on PATH, so something has to name the
# dotnet binary; `dotnet exec` then runs the assembly against the runtime that ships
# beside that binary, which is why nothing here sets DOTNET_ROOT.
#
# This script writes nothing of its own to stdout. Stdout carries one JSON value, the
# bridge's, and a line printed here would be a second value the runner reads as a
# bridge that answered twice. The two path queries are captured, and every diagnostic
# below goes to stderr.
#
# It publishes nothing. A missing assembly is reported rather than built, because
# a build here would run inside the request the runner is timing.
set -eu

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=paths.sh
. "$HERE/paths.sh"
resolve_bridge_paths "$HERE"

# --print-bin names where the dotnet binary is or would be and installs nothing, so a
# cold cache is reported here instead of downloading 229 MB inside a timed batch.
DOTNET_BIN="$("$HERE/../../../install-toolchain" --version "$DOTNET_VERSION_TOKEN" --print-bin)"
if [ ! -x "$DOTNET_BIN" ]; then
    echo "no .NET SDK at $DOTNET_BIN. Run this lane's install-toolchain." >&2
    exit 2
fi

APP="$BRIDGE_OUT/app/bridge.dll"
if [ ! -f "$APP" ]; then
    echo "no published bridge at $APP. prepare publishes it, and the runner runs that first." >&2
    exit 2
fi

exec "$DOTNET_BIN" exec "$APP"
