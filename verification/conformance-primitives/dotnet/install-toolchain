#!/usr/bin/env bash
# Install a pinned .NET SDK into a cache dir. Nothing system-wide.
#
# Separated from check so the download can be done once, ahead of
# time, on a machine that has egress, and the run can then happen with no
# network at all. The run script calls this when the SDK is missing, so calling
# it by hand is optional.
#
#   ./install-toolchain                    # install if absent, then print BASE
#   ./install-toolchain --version <token>  # the pin `versions` lists for <token>; default when absent
#   ./install-toolchain --base <dir>       # use this SDK as is, download nothing
#   ./install-toolchain --cache-root <dir> # put or find the SDK under this root
#   ./install-toolchain --print-base       # print where BASE is or would be, install nothing
#   ./install-toolchain --print-bin        # print the dotnet binary a caller drives, install nothing
#   ./install-toolchain --print-cache      # print this lane's cache dir, install nothing
#   ./install-toolchain --force            # re-download over an existing install
#   ./install-toolchain --help             # this text
#
# Run it directly: the shebang names bash.
#
# The version comes from --version, else DCA_VERSION, else `default`, the first
# default line of `versions` beside this script. A token that file does not
# list is refused with exit 2. Each version installs into a directory of its
# own, so two versions sit side by side in one cache.
#
# BASE is the unpacked SDK: the directory DOTNET_ROOT names, with the dotnet
# binary at its root. A caller is given it, or the root the lanes live under;
# nothing here searches PATH and nothing here is put on PATH.
#
# --cache-root and --print-cache are one level apart, which is why the flag
# carries the word root: the root holds every lane and this lane's directory is
# `dotnet` under it, so --print-cache answers <root>/dotnet and feeding that
# back in as a root would install into dotnet/dotnet.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed SDK to use as is, nothing downloaded.
#                       --force is refused with it given: this script deletes only what it created.
#   --cache-root <dir>  root to install into, as <root>/dotnet
#   $DCA_CACHE/dotnet
#   $XDG_CACHE_HOME/dca/dotnet
#   $HOME/.cache/dca/dotnet
set -euo pipefail

# Pinned by exact SDK version. Microsoft publishes SHA-512 rather than the
# SHA-256 the Go and JVM lanes verify, so this lane runs sha512sum; because of that
# difference the three installers do not share one helper.
# Each token's SDK version is the second field of its line in `versions`, and
# its two hashes are below, keyed by token; the token is the .NET major, so 10
# is .NET 10 LTS, whose support ends 2028-11-14. Bumping a pin means changing
# the version there and both hashes here together, from:
#   https://builds.dotnet.microsoft.com/dotnet/release-metadata/10.0/releases.json
# reading .releases[] | select(.sdk.version=="<version>") | .sdk.files[].hash
pin_checksums() {
  case "$1" in
    10) SHA512_x64=1033977dd837150e0814cf0c5d5b17ceb63925fda7ba2158b47258a4bd7c048cf82eac3bc1166f3146f53124a3f5fba09db1de1260d2ce96399860303b404b48
        SHA512_arm64=a1b45da58e5591fff909a6126ac6bfc1ef9c12bc72c0625f7815e83a82be1a902317ee96926cbbf81324a45c6abf2ed8102a216d0507879cc166159af78d1b77 ;;
    *) echo "versions lists $1, and this installer carries no checksum for it." >&2
       echo "Add both hashes for its SDK to pin_checksums before the token can install." >&2
       exit 2 ;;
  esac
}

# Which pinned archive this host would download, resolved on the leg that
# downloads one and nowhere else.
#
# An OS or an architecture the pin does not cover is a reason to refuse a
# download. It is not a reason to refuse --base, which is the flag an operator
# on such a host reaches for and which the refusals below tell them to pass, and
# it is not a reason to refuse the print queries, which name a path and install
# nothing. So this is a function the install branch calls rather than a gate at
# the top of the file: run before the argument line is read, it answered every
# invocation on those hosts with the advice to pass a flag it had already made
# unreachable. The OS is tested here because the archive below is a Linux build
# whatever this host is: without the refusal a Mac downloads it, passes the
# checksum, unpacks a Linux tree and dies on the first exec.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned archive is a Linux build." >&2
       echo "Install .NET SDK ${SDK_VERSION} by hand and pass --base naming the directory holding it." >&2
       exit 2 ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  DARCH=x64 ;;
    aarch64|arm64) DARCH=arm64 ;;
    *) echo "unsupported arch $(uname -m); install .NET SDK ${SDK_VERSION} by hand and pass --base" >&2; exit 2 ;;
  esac
  sha_var="SHA512_${DARCH}"; WANT_SHA="${!sha_var}"
  TARBALL="dotnet-sdk-${SDK_VERSION}-linux-${DARCH}.tar.gz"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# There is one cache dir rule, so it is kept in one file: DCA_CACHE, or the OS
# cache dir, or a refusal naming DCA_CACHE.
# shellcheck source=../_shared/cache.sh
. "$HERE/../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where BASE would be and the print actions have to answer
# for the flags this invocation was given rather than for the defaults. Both
# path values are made absolute here, at the one place they are read; cache.sh
# explains why.
base=""
cache_root=""
print=""
force=0
version="${DCA_VERSION:-default}"
while [ $# -gt 0 ]; do
  case "$1" in
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding the SDK" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the lanes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --version)
      [ $# -ge 2 ] || { echo "--version needs a token from $HERE/versions, or default" >&2; exit 2; }
      version="$2"; shift 2 ;;
    --print-base)  print=base; shift ;;
    --print-bin)   print=bin; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The version first: an unlisted token refuses every action, print queries
# included, so no caller is handed a path for a version nobody pinned.
resolve_version_pin "$HERE/versions" "$version" || exit 2
SDK_VERSION="$DCA_VERSION_RELEASE"
pin_checksums "$DCA_VERSION_TOKEN"

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/dotnet"
else
  resolve_cache_dir dotnet
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the lane name alone, so it answers
# first, ahead of everything that depends on the pin.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

BASE="${base:-$CACHE/sdk-${SDK_VERSION}}"
DOTNET_BIN="$BASE/dotnet"

# The other two queries answer and stop, before the install branch and before
# any directory is created. A caller that must not download asks one of these,
# and a cold cache root is still cold afterwards.
case "$print" in
  base)  printf '%s\n' "$BASE"; exit 0 ;;
  bin)   printf '%s\n' "$DOTNET_BIN"; exit 0 ;;
esac

# --force and --base name opposite things, and taken together this
# script deletes a directory it did not create: --force enters the install branch
# even for an SDK that is already there and complete, and
# `rm -rf "$BASE"` below deletes whatever --base pointed at.
# The pair is refused by name rather than the rm made conditional: an installer
# may delete what it created and nothing else.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned SDK over the install directory, and it starts by" >&2
  echo "deleting that directory. --base $base is a directory you pointed" >&2
  echo "this script at rather than one it created, so this run would delete yours. Refusing." >&2
  echo "Drop --base to re-download into the cache dir, or remove $base" >&2
  echo "yourself first if replacing it is what you meant." >&2
  exit 2
fi

# Passing --base claims something about a directory, and this is where the claim is checked.
# The CLI is asked for its version rather than only tested for -x, because an
# SDK unpacked for another architecture answers -x and then fails the build
# with a message about the build.
if [ -n "$base" ]; then
  if [ ! -x "$DOTNET_BIN" ]; then
    echo "--base $base has no dotnet binary at its root" >&2
    exit 2
  fi
  if ! DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 \
      DOTNET_CLI_HOME="$CACHE/clihome" "$DOTNET_BIN" --version >/dev/null 2>&1; then
    echo "--base $base has a dotnet that will not run on this host" >&2
    exit 2
  fi
fi

installed=0
if [ "$force" = 1 ] || [ ! -x "$DOTNET_BIN" ]; then
  # Only this branch downloads, so this is where the host is checked against
  # the pin.
  pinned_platform
  mkdir -p "$CACHE"
  # The cache dir is shared: $HOME is a bind mount that several concurrent runs
  # see at once. One exclusive lock covers the whole install, so a second caller
  # waits here instead of writing over the first caller's download or reading an
  # SDK directory that is still being unpacked.
  exec 9>"$CACHE/.install.lock"
  flock 9
  # Re-tested under the lock, because the caller that held it first may have
  # finished the install while this one waited. A --force run always installs.
  if [ "$force" = 1 ] || [ ! -x "$DOTNET_BIN" ]; then
    # Armed before either temp exists, so a failing `mktemp -d` cannot leave the
    # tarball temp file behind. `rm` on an empty name is a silent no-op, which is
    # what the trap sees when it fires before the second mktemp has answered.
    sdk_tar=""
    sdk_tmp=""
    trap 'rm -f "$sdk_tar"; rm -rf "$sdk_tmp"' EXIT
    sdk_tar="$(mktemp "$CACHE/.${TARBALL}.XXXXXX")"
    sdk_tmp="$(mktemp -d "${BASE}.XXXXXX")"
    echo "fetching $TARBALL (~229 MB, needs network) ..." >&2
    curl -fSL --max-time 900 -o "$sdk_tar" \
      "https://builds.dotnet.microsoft.com/dotnet/Sdk/${SDK_VERSION}/${TARBALL}"
    echo "${WANT_SHA}  $sdk_tar" | sha512sum -c - >&2
    # The SDK tarball unpacks as its own root, with no leading directory to strip.
    tar -xzf "$sdk_tar" -C "$sdk_tmp"
    rm -f "$sdk_tar"
    # The rename is the last step, so $BASE is either absent or a
    # complete SDK. Nobody outside the lock sees a half-unpacked tree.
    rm -rf "$BASE"
    mv "$sdk_tmp" "$BASE"
    trap - EXIT
    installed=1
    echo "installed to $BASE (~624 MB extracted)" >&2
    # Only on a fresh install. The reuse path says the path and nothing else.
    DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 \
      DOTNET_CLI_HOME="$CACHE/clihome" "$DOTNET_BIN" --version >&2
  fi
  exec 9>&-
fi
# Printed on the reuse path too. If an SDK is off PATH and nobody can name it, the
# next caller downloads it again, or concludes it is not there.
[ "$installed" = 1 ] || echo "already present at $BASE" >&2

printf '%s\n' "$BASE"
