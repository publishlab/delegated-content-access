#!/usr/bin/env bash
# Opt-in .NET conformance check, not part of the default suite.
#
# The default `node --test` run and `js/check` never fetch an SDK and never
# compile C#, so the normal suite needs no network and no toolchain. Use this
# script to run the .NET side on purpose: every corpus set this lane
# declares, through this lane's own operation bridge.
#
#   ./check                     # every corpus set this lane declares
#   ./check --record <file>     # also write this run's lane record to that file
#
# The corpus run goes through this lane's own bridge.json, which owns a
# separate toolchain install and build with no flags of its own; this script
# asks install-toolchain the same, flagless way, only to print the version
# banner below, so the banner names the toolchain that answered.
#
# It needs network only for the first toolchain install (~229 MB download,
# ~624 MB extracted). After that everything here runs with no egress at all,
# which is why it is never wired into the suite: run it by hand on a machine
# that has network once, then forever offline. Nothing is installed
# system-wide and no build output is committed; both the SDK and the build
# output live only in the cache dir.
#
# Exit codes, the three ../README.md names:
#   0  every corpus set this lane was asked held
#   1  the bridge answered inside the contract and answered wrongly
#   2  a set verified nothing, or no usable .NET SDK was found
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The corpus-set driver step this check is built from.
# shellcheck source=../_shared/driver-steps.sh
. "$HERE/../_shared/driver-steps.sh"

# The name this lane writes into a record. The cross-lane aggregator keys
# every comparison it makes on that name.
DCA_LANE=dotnet
# The file a record goes to. It stays empty until --record names a file, and
# no record is written while it stays empty.
DCA_RECORD=""

while [ $# -gt 0 ]; do
    case "$1" in
        --record)
            [ $# -ge 2 ] || { echo "--record needs a file path to write the lane record to" >&2; exit 2; }
            DCA_RECORD="$2"; shift 2 ;;
        *)
            echo "dotnet/check takes no argument beside --record: it always answers the whole case corpus through the driver." >&2
            exit 2 ;;
    esac
done

# The installer is idempotent and prints BASE on stdout. DOTNET_ROOT is not
# exported: the CLI pins the runtime root of the apphost it spawns to its own
# location, so invoking "$BASE/dotnet" decides which SDK answers. Called
# with no flags, the same way this lane's own prepare step calls it, so the
# banner below names the SDK that actually answers the corpus.
if ! BASE="$("$HERE/install-toolchain")"; then
    echo "no .NET SDK, so nothing was verified." >&2
    exit 2
fi

echo "== $("$BASE/dotnet" --version) ==" >&2

run_driver_steps

if [ -n "${DCA_RECORD:-}" ]; then
    write_driver_record || DCA_WALK_STATUS=2
fi
exit "$DCA_WALK_STATUS"
