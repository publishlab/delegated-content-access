#!/usr/bin/env bash
# Install a pinned Node.js into a cache dir. Nothing system-wide.
#
# Separated from check so the download can be done once, ahead of time, on a
# machine that has egress, and the run can then happen with no network at all.
# A binding's check and its prepare step call this, so calling it by hand is
# optional.
#
#   ./install-toolchain                    # install if absent, then print BASE
#   ./install-toolchain --version <token>  # the pin `versions` lists for <token>; default when absent
#   ./install-toolchain --base <dir>       # use this Node as is, download nothing
#   ./install-toolchain --cache-root <dir> # put or find the install under this root
#   ./install-toolchain --print-base       # print where BASE is or would be, install nothing
#   ./install-toolchain --print-bin        # print the node binary a caller drives, install nothing
#   ./install-toolchain --print-cache      # print this runtime's cache dir, install nothing
#   ./install-toolchain --force            # re-download over an existing install
#   ./install-toolchain --help             # this text
#
# Run it directly: the shebang names bash.
#
# The version comes from --version, else DCA_VERSION, else `default`, the first
# default line of `versions` beside this script. A token that file does not
# list is refused with exit 2. Each version installs into a directory of its
# own, so Node 22 and Node 24 sit side by side in one cache.
#
# BASE is the unpacked release, with bin/node under it. A caller is given it,
# or the root the runtimes live under; nothing here searches PATH and nothing
# here is put on PATH. The JavaScript driver that runs the corpus keeps running
# on whatever runtime DCA_JS names; this installs the Node that answers as a
# bridge.
#
# --cache-root and --print-cache are one level apart, which is why the flag
# carries the word root: the root holds every runtime and this runtime's
# directory is `node` under it, so --print-cache answers <root>/node and feeding
# that back in as a root would install into node/node.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed Node to use as is, nothing downloaded.
#                       --force is refused with it given: this script deletes only what it created.
#   --cache-root <dir>  root to install into, as <root>/node
#   $DCA_CACHE/node
#   $XDG_CACHE_HOME/dca/node
#   $HOME/.cache/dca/node
set -euo pipefail

# Pinned by exact version: each token's release is the second field of its line
# in `versions`, and its two checksums are below, keyed by token. Each value is
# the line for that archive in the release's SHASUMS256.txt, read on
# 2026-09-30:
#   https://nodejs.org/dist/v<release>/SHASUMS256.txt
# Bumping a pin means changing the release there and both checksums here
# together. The archive is the `.tar.gz` build rather than the `.tar.xz` one,
# because the gzip build needs only `tar` and `gzip` to unpack, and `xz` is not
# present on every host this runs on.
pin_checksums() {
  case "$1" in
    24) SHA256_x64=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
        SHA256_arm64=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5 ;;
    22) SHA256_x64=1084aa36196bba4c3a5e69a1ee388a6e4ff729dad09445fbcd434b28fe3c24af
        SHA256_arm64=5ced2d48d1d7198739b7f86804de0171aefb6823b684b12341d3321afc3cb0b2 ;;
    *) echo "versions lists $1, and this installer carries no checksum for it." >&2
       echo "Add both checksums for its release to pin_checksums before the token can install." >&2
       exit 2 ;;
  esac
}

# Which pinned archive this host would download, resolved on the leg that
# downloads one and nowhere else.
#
# An OS or an architecture the pin does not cover is a reason to refuse a
# download. It is not a reason to refuse --base, which is the flag an operator
# on such a host reaches for and which the refusals below tell them to pass, and
# it is not a reason to refuse the print queries, which name a path and install
# nothing. The OS is tested because the archive is a Linux build whatever this
# host is: a Mac would download it, pass the checksum and fail on the first
# exec.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned archive is a Linux build." >&2
       echo "Install Node ${NODE_VERSION} by hand and pass --base naming the directory holding it." >&2
       exit 2 ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  NARCH=x64 ;;
    aarch64|arm64) NARCH=arm64 ;;
    *) echo "unsupported arch $(uname -m); install Node ${NODE_VERSION} by hand and pass --base" >&2; exit 2 ;;
  esac
  sha_var="SHA256_${NARCH}"; WANT_SHA="${!sha_var}"
  TARBALL="node-v${NODE_VERSION}-linux-${NARCH}.tar.gz"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The cache dir rule and the version list reader are written once, in the file
# sourced below.
# shellcheck source=../_shared/cache.sh
. "$HERE/../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where BASE would be and the print actions have to answer
# for the flags this invocation was given rather than for the defaults. Both
# path values are made absolute here, at the one place they are read; cache.sh
# explains why.
base=""
cache_root=""
print=""
force=0
version="${DCA_VERSION:-default}"
while [ $# -gt 0 ]; do
  case "$1" in
    --version)
      [ $# -ge 2 ] || { echo "--version needs a token from $HERE/versions, or default" >&2; exit 2; }
      version="$2"; shift 2 ;;
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding bin/node" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the runtimes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --print-base)  print=base; shift ;;
    --print-bin)   print=bin; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The version first: an unlisted token refuses every action, print queries
# included, so no caller is handed a path for a version nobody pinned.
resolve_version_pin "$HERE/versions" "$version" || exit 2
NODE_VERSION="$DCA_VERSION_RELEASE"
pin_checksums "$DCA_VERSION_TOKEN"

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/node"
else
  resolve_cache_dir node
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the runtime name alone, so it answers
# first, ahead of everything that depends on the pin.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

BASE="${base:-$CACHE/node-v${NODE_VERSION}}"
NODE_BIN="$BASE/bin/node"

# The other two queries answer and stop, before the install branch and before
# any directory is created. A caller that must not download asks one of these,
# and a cold cache root is still cold afterwards.
case "$print" in
  base)  printf '%s\n' "$BASE"; exit 0 ;;
  bin)   printf '%s\n' "$NODE_BIN"; exit 0 ;;
esac

# --force and --base name opposite things, and taken together this script
# deletes a directory it did not create. The pair is refused by name rather
# than the rm made conditional: an installer may delete what it created and
# nothing else.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned release over the install directory, and it starts by" >&2
  echo "deleting that directory. --base $base is a directory you pointed this" >&2
  echo "script at rather than one it created, so this run would delete yours. Refusing." >&2
  echo "Drop --base to re-download into the cache dir, or remove $base" >&2
  echo "yourself first if replacing it is what you meant." >&2
  exit 2
fi

# The binary --base names has to be there and also run: a release unpacked for
# another architecture answers -x and then fails the first batch, which reads as
# a broken bridge and is not one.
if [ -n "$base" ]; then
  if [ ! -x "$NODE_BIN" ]; then
    echo "--base $base has no bin/node; point it at an unpacked Node release" >&2
    exit 2
  fi
  if ! "$NODE_BIN" --version >/dev/null 2>&1; then
    echo "--base $base has a bin/node that will not run on this host" >&2
    exit 2
  fi
fi

installed=0
if [ "$force" = 1 ] || [ ! -x "$NODE_BIN" ]; then
  # This branch downloads, so this is where it checks that the pin covers the
  # host.
  pinned_platform
  command -v curl >/dev/null 2>&1 || {
    echo "no curl on PATH, and fetching $TARBALL is the one step here that needs it." >&2
    echo "Download https://nodejs.org/dist/v${NODE_VERSION}/$TARBALL on a machine that has egress," >&2
    echo "unpack it, and pass --base naming the directory holding bin/node." >&2
    exit 2
  }
  mkdir -p "$CACHE"
  # The cache dir is shared: $HOME is a bind mount that several concurrent runs
  # see at once. One exclusive lock covers the whole install, so a second caller
  # waits here instead of writing over the first caller's download or reading a
  # release that is still being unpacked.
  exec 9>"$CACHE/.install.lock"
  flock 9
  # Re-tested under the lock, because the caller that held it first may have
  # finished the install while this one waited. A --force run always installs.
  if [ "$force" = 1 ] || [ ! -x "$NODE_BIN" ]; then
    # Armed before either temp exists, so a failing `mktemp -d` cannot leave the
    # tarball temp file behind.
    node_tar=""
    node_tmp=""
    trap 'rm -f "$node_tar"; rm -rf "$node_tmp"' EXIT
    node_tar="$(mktemp "$CACHE/.${TARBALL}.XXXXXX")"
    node_tmp="$(mktemp -d "${BASE}.XXXXXX")"
    echo "fetching $TARBALL (~55 MB, needs network) ..." >&2
    if ! curl -fSL --max-time 600 -o "$node_tar" "https://nodejs.org/dist/v${NODE_VERSION}/$TARBALL"; then
      echo "could not fetch $TARBALL. This is the only step here that needs egress; on a machine" >&2
      echo "with none, download it elsewhere, unpack it, and pass --base." >&2
      exit 2
    fi
    got_sha="$(sha256sum "$node_tar" | cut -d' ' -f1)"
    if [ "$got_sha" != "$WANT_SHA" ]; then
      echo "checksum mismatch on $TARBALL" >&2
      echo "  expected $WANT_SHA (SHASUMS256.txt of v${NODE_VERSION})" >&2
      echo "  got      $got_sha" >&2
      exit 2
    fi
    echo "checksum verified: $TARBALL $got_sha" >&2
    tar -xzf "$node_tar" -C "$node_tmp" --strip-components=1
    rm -f "$node_tar"
    # The proof runs on the unpacked binary before it is promoted, so a release
    # that will not start here is never promoted for the next caller to reuse.
    if ! "$node_tmp/bin/node" --version >/dev/null 2>&1; then
      echo "$TARBALL unpacked and bin/node will not run on this host." >&2
      echo "Install Node ${NODE_VERSION} by hand and pass --base." >&2
      exit 2
    fi
    # The rename is the last step, so $BASE is either absent or a complete
    # release. Nobody outside the lock sees a half-unpacked tree.
    rm -rf "$BASE"
    mv "$node_tmp" "$BASE"
    trap - EXIT
    installed=1
    echo "installed to $BASE" >&2
    "$NODE_BIN" -p '`node ${process.version}, OpenSSL ${process.versions.openssl}`' >&2
  fi
  exec 9>&-
fi
# Said on the reuse path too. If nobody can name a runtime that is off PATH,
# the next caller downloads it again, or concludes it is not there.
[ "$installed" = 1 ] || echo "already present at $BASE" >&2

printf '%s\n' "$BASE"
