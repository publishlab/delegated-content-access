#!/usr/bin/env bash
# Opt-in RustCrypto conformance check. Not part of the default public gate.
#
# The default `node --test` run touches no Rust at all, so it needs no network
# and no compiler. This script runs the RustCrypto lane on request: every
# corpus set this lane declares, through this lane's own operation bridge.
#
#   ./check                     # every corpus set this lane declares
#   ./check --record <file>     # also write this run's lane record to that file
#   ./check --version <v>       # default, all or a token of ../versions; one run per token
#
# The corpus runs once per selected runtime version, through run_lane_versions
# in ../../_shared/driver-steps.sh. For each version this script installs it
# through ../install-toolchain --version, prints its banner and records the
# version the installed binary reports. bridge.json's prepare step and the
# answering process install and run the same version, because DCA_VERSION
# carries the token to them.
#
# It needs network the first time, for the toolchain (~380 MB download) and
# once per Cargo.lock for the crates the build step vendors (~40 MB). After
# that the cached toolchain and the vendored crates are reused with no network,
# and the build runs with cargo's --frozen. Some execution environments have no
# egress, which is exactly why this is never wired into the suite. Nothing is
# installed system-wide and no binary is committed; the toolchain and the
# vendored crates live only in the cache dir ../install-toolchain names, which
# `../install-toolchain --print-cache` prints without installing anything.
#
# Exit codes, the three ../../README.md names:
#   0  every corpus set this lane was asked held
#   1  the bridge answered inside the contract and answered wrongly
#   2  a set verified nothing, no usable toolchain was found, or --version
#      names a token ../versions does not list
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The corpus-set driver step this check is built from.
# shellcheck source=../../_shared/driver-steps.sh
. "$HERE/../../_shared/driver-steps.sh"

# What this lane calls itself in a record, which is the name the cross-lane
# aggregator keys every comparison it makes on. A lane one level down is named
# by its path from the conformance directory, the same name the driver gives it.
DCA_LANE=rust/rustcrypto
# Where a record goes, empty until --record names a file and no record written
# while it stays empty.
DCA_RECORD=""
# Which runtime versions run: --version, else DCA_VERSION, else default.
DCA_VERSION_SELECTION="${DCA_VERSION:-default}"

while [ $# -gt 0 ]; do
    case "$1" in
        --record)
            [ $# -ge 2 ] || { echo "--record needs a file path to write the lane record to" >&2; exit 2; }
            DCA_RECORD="$2"; shift 2 ;;
        --version)
            [ $# -ge 2 ] || { echo "--version needs default, all or a token of $HERE/../versions" >&2; exit 2; }
            DCA_VERSION_SELECTION="$2"; shift 2 ;;
        *)
            echo "rust/rustcrypto/check takes --record <file> and --version <v> and nothing else:" >&2
            echo "it always answers the whole case corpus through the driver." >&2
            exit 2 ;;
    esac
done

# Installs one version, prints its banner and sets DCA_RUNTIME_OBSERVED from
# what the installed binary says, which is what the record carries.
lane_runtime() {
    local base crate_versions
    if ! base="$("$HERE/../install-toolchain" --version "$1")"; then
        echo "no Rust toolchain for version $1." >&2
        return 1
    fi
    echo "== $("$base/bin/rustc" --version), $("$base/bin/cargo" --version) ==" >&2
    # The crate versions are the ones Cargo.lock pins, read off the lock rather
    # than repeated here.
    crate_versions=$(awk '
        /^name = / { name = $3; gsub(/"/, "", name) }
        /^version = / && name ~ /^(aes-gcm|p256|hkdf|rsa|sha2|base64|serde_json)$/ {
            version = $3; gsub(/"/, "", version); printf "%s %s%s", sep, name, " " version; sep = ","
        }' "$HERE/v1/Cargo.lock")
    echo "== crypto: RustCrypto crates, pure Rust, no OpenSSL; Cargo.lock pins${crate_versions} ==" >&2
    DCA_RUNTIME_OBSERVED="$("$base/bin/rustc" --version | awk '{ print $2 }')" || return 1
}

run_lane_versions "$HERE/.."
exit "$DCA_LANE_STATUS"
