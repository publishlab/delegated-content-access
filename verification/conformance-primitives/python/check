#!/usr/bin/env bash
# Opt-in Python conformance check, not part of the default suite.
#
# The default `node --test` run and `js/check` never fetch an interpreter and
# never install a wheel, so the normal suite needs no network and no toolchain.
# Use this script to run the Python side on purpose: every corpus set this
# lane declares, through this lane's own operation bridge.
#
#   ./check                     # every corpus set this lane declares
#   ./check --record <file>     # also write this run's lane record to that file
#
# The corpus run goes through this lane's own bridge.json, which owns a
# separate toolchain install as its prepare step, with no flags of its own;
# this script asks install-toolchain the same, flagless way, only to print the
# version banner below, so the banner names the toolchain that answered.
#
# It needs network only for the first toolchain install (~36 MB interpreter,
# ~5 MB of wheels). After that everything here runs with no egress at all, which
# is why it is never wired into the suite: run it by hand on a machine that has
# network once, then forever offline. Nothing is installed system-wide, and
# bytecode caches go to the cache dir rather than beside the sources, so a
# checkout never carries build output.
#
# Exit codes, the three ../README.md names:
#   0  every corpus set this lane was asked held
#   1  the bridge answered inside the contract and answered wrongly
#   2  a set verified nothing, or no usable Python toolchain was found
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The corpus-set driver step this check is built from.
# shellcheck source=../_shared/driver-steps.sh
. "$HERE/../_shared/driver-steps.sh"

# The name this lane writes into a record. The cross-lane aggregator keys
# every comparison it makes on that name.
DCA_LANE=python
# The file a record goes to. It stays empty until --record names a file, and
# no record is written while it stays empty.
DCA_RECORD=""

while [ $# -gt 0 ]; do
    case "$1" in
        --record)
            [ $# -ge 2 ] || { echo "--record needs a file path to write the lane record to" >&2; exit 2; }
            DCA_RECORD="$2"; shift 2 ;;
        *)
            echo "python/check takes no argument beside --record: it always answers the whole case corpus through the driver." >&2
            exit 2 ;;
    esac
done

# The installer is idempotent and prints BASE on stdout. Called with no flags,
# the same way this lane's own prepare step calls it, so the banner below
# names the interpreter that actually answers the corpus.
if ! BASE="$("$HERE/install-toolchain")"; then
    echo "no Python toolchain, so nothing was verified." >&2
    exit 2
fi
PYTHON="$BASE/bin/python3"
if [ ! -x "$PYTHON" ]; then
    echo "installer named $BASE, which holds no executable python3 binary." >&2
    exit 2
fi

echo "== $("$PYTHON" -VV | head -1) ==" >&2

run_driver_steps

if [ -n "${DCA_RECORD:-}" ]; then
    write_driver_record || DCA_WALK_STATUS=2
fi
exit "$DCA_WALK_STATUS"
