#!/usr/bin/env bash
# Install the pinned cryptography wheels this binding runs on into a cache dir,
# for the pinned CPython ../install-toolchain installs. Nothing system-wide,
# nothing in the checkout.
#
# bridge.json names this as the prepare step. It calls ../install-toolchain
# first, which installs the interpreter when it is missing, and then installs
# the wheels into this binding's site dir, so calling it by hand is optional.
#
#   ./install-libraries                    # install if absent, then print the site dir
#   ./install-libraries --base <dir>       # use this CPython and its own packages, download nothing
#   ./install-libraries --cache-root <dir> # put or find the install under this root
#   ./install-libraries --print-site       # print the package dir the run puts on PYTHONPATH,
#                                          # install nothing, and nothing at all under --base
#   ./install-libraries --print-cache      # print this binding's cache dir, install nothing
#   ./install-libraries --force            # re-download the wheels over an existing install
#   ./install-libraries --help             # this text
#
# Run it directly: the shebang names bash.
#
# The cache dir is keyed by runtime and binding, `python/cryptography` under
# the cache root, so a second binding on this CPython never shares a site dir
# with this one. --cache-root takes the root that holds every lane, as the
# runtime installer's flag does, and is passed on to it: --print-cache answers
# <root>/python/cryptography.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed CPython that imports cryptography, nothing downloaded
#   --cache-root <dir>  root to install into, as <root>/python/cryptography
#   $DCA_CACHE/python/cryptography
#   $XDG_CACHE_HOME/dca/python/cryptography
#   $HOME/.cache/dca/python/cryptography
set -euo pipefail

# requirements-<abi>-linux.txt beside this script carries one --hash line per
# wheel, both architectures in the one list, because pip takes several --hash
# lines per requirement and picks which wheel to ask for by the host tags. Two
# facts weld that file to the values here:
#
#   PYTHON_ABI_TAG  cffi ships no abi3 wheel, only cp314-cp314 and friends, so
#                   its hash is tied to the interpreter's minor version. An
#                   interpreter that is not 3.14 needs a different requirements
#                   file, and this script says so rather than failing on a hash.
#   MIN_GLIBC       --require-hashes pins the file, but pip still chooses which
#                   file to ask for, by glibc version. cryptography publishes
#                   manylinux_2_17 / _2_28 / _2_34 builds of one version; the
#                   hash here is the _2_34 one. On an older host pip would ask
#                   for a wheel this file does not name and the install would
#                   fail as a hash mismatch, which reads like a supply-chain
#                   alarm and is not one. The check below refuses first, by name.
PYTHON_ABI_TAG=cp314
MIN_GLIBC=2.34

# The arch the site dir and wheelhouse are keyed by. An OS or an arch the pins
# do not cover is refused here, where the pin-keyed directories are named, and
# not before the argument line is read, so --base and --print-cache still
# answer on such a host.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned wheels are Linux builds." >&2
       echo "Install CPython with cryptography by hand and pass --base naming it." >&2
       exit 2 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  PARCH=x86_64 ;;
    aarch64|arm64) PARCH=aarch64 ;;
    *) echo "unsupported arch $(uname -m); install CPython with cryptography" >&2
       echo "by hand and pass --base" >&2
       exit 2 ;;
  esac
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER="$HERE/../install-toolchain"
REQUIREMENTS="$HERE/requirements-${PYTHON_ABI_TAG}-linux.txt"

# The cache dir rule is defined once, in one file: DCA_CACHE, or the OS
# cache dir, or a refusal naming DCA_CACHE.
# shellcheck source=../../_shared/cache.sh
. "$HERE/../../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where the site dir and the wheelhouse would be, and the
# print actions have to answer for the flags this invocation was given rather
# than for the defaults.
base=""
cache_root=""
print=""
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding the interpreter" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the lanes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --print-site)  print=site; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The flags the runtime installer shares with this script, passed on as given,
# and the version the lane check selected for this run in DCA_VERSION, so the
# interpreter the wheels go beside is that version's pin.
runtime_args=(--version "${DCA_VERSION:-default}")
[ -z "$cache_root" ] || runtime_args+=(--cache-root "$cache_root")
[ -z "$base" ] || runtime_args+=(--base "$base")

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/python/cryptography"
else
  resolve_cache_dir python/cryptography
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the binding name alone.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

# The packages this binding installs are keyed by ABI tag and arch, so two
# interpreters never share one site dir: a cp314 cffi build is unimportable
# under any other minor version. That keying is also why an interpreter handed
# in with --base has no site dir here. --base means this exact toolchain with
# nothing downloaded, the check below refuses one that cannot already import
# cryptography, and so a --base run reads the packages the operator installed
# beside their own interpreter. Putting the pinned directory on that run's
# PYTHONPATH would shadow them with an extension module built for a different
# CPython, and the import error that follows reads as a broken lane rather than
# as two toolchains mixed. --print-site therefore answers nothing for a --base
# run, and the bridge builds PYTHONPATH from that answer.
if [ -n "$base" ]; then
  SITE_DIR=""
  WHEELHOUSE=""
else
  pinned_platform
  SITE_DIR="$CACHE/site-${PYTHON_ABI_TAG}-${PARCH}"
  WHEELHOUSE="$CACHE/wheelhouse-${PYTHON_ABI_TAG}-${PARCH}"
fi

# The query answers and stops, before the runtime installer runs and before any
# directory is created. A caller that must not download asks it, and a cold
# cache root is still cold afterwards.
if [ "$print" = site ]; then printf '%s\n' "$SITE_DIR"; exit 0; fi

# --force here re-fetches the wheels into this binding's site dir, and a --base
# run has none: it reads the packages the operator installed.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned wheels into this binding's site dir under" >&2
  echo "$CACHE, and --base $base names an interpreter that carries its own packages" >&2
  echo "and uses no site dir here. Refusing. Drop --base to rebuild the pinned site dir." >&2
  exit 2
fi

# The interpreter first. The runtime installer is idempotent, installs the
# pinned CPython when it is missing, checks a --base one, and prints BASE.
if ! BASE="$("$INSTALLER" ${runtime_args[@]+"${runtime_args[@]}"})"; then
  echo "no Python toolchain, so no wheels were installed." >&2
  exit 2
fi
PYTHON_BIN="$BASE/bin/python3"

# The interpreter --base names has to already import cryptography, because
# --base promises this exact toolchain with nothing downloaded and every check
# this lane runs goes through that library. An interpreter without it is refused
# here with the command that would fix it, rather than quietly turning --base
# into a wheel fetch.
if [ -n "$base" ]; then
  if ! PYTHONNOUSERSITE=1 "$PYTHON_BIN" -s -c 'import cryptography' >/dev/null 2>&1; then
    echo "--base $base cannot import cryptography, and every check this lane runs" >&2
    echo "goes through it. --base means this exact toolchain with nothing downloaded, so" >&2
    echo "this script will not fetch wheels into an interpreter you supplied. Install it" >&2
    echo "yourself with" >&2
    echo "  $PYTHON_BIN -m pip install -r $REQUIREMENTS" >&2
    echo "or drop --base and let this script install the pinned CPython and wheels." >&2
    exit 2
  fi
fi

# ---- the wheels --------------------------------------------------------------
#
# Two phases on purpose, which is also the shape the JVM and .NET installers
# already have: fetch once where there is egress, install with none. The
# wheelhouse is this binding's cacheable artefact, the way the unpacked JDK is
# the JVM runtime's.

# Asked of the interpreter that will run, with this binding's site dir on the
# path when there is one. A --base run has none, and the question is then
# whether the supplied interpreter imports cryptography on its own, which is the
# same question the --base check above already answered yes to.
have_packages() {
  if [ -n "$SITE_DIR" ]; then
    PYTHONPATH="$SITE_DIR" PYTHONNOUSERSITE=1 "$PYTHON_BIN" -c 'import cryptography' >/dev/null 2>&1
  else
    PYTHONNOUSERSITE=1 "$PYTHON_BIN" -c 'import cryptography' >/dev/null 2>&1
  fi
}

installed=0
if [ "$force" = 1 ] || ! have_packages; then
  # Only the pinned interpreter reaches this branch, because --base refuses
  # above when it cannot import cryptography rather than fetching wheels into an
  # interpreter it was handed. The tag is still asserted, so a pin bumped in one
  # place and not the other says which two values disagree instead of failing on
  # a hash: the cffi wheel named in the requirements file is built for one
  # CPython minor version.
  actual_tag="$("$PYTHON_BIN" -c 'import sys; print("cp%d%d" % sys.version_info[:2])')"
  if [ "$actual_tag" != "$PYTHON_ABI_TAG" ]; then
    echo "$PYTHON_BIN is $actual_tag and the pinned wheels are $PYTHON_ABI_TAG." >&2
    echo "cffi publishes no abi3 wheel, so its hash is welded to the interpreter's" >&2
    echo "minor version and $REQUIREMENTS cannot install here." >&2
    echo "PYTHON_VERSION in $INSTALLER and PYTHON_ABI_TAG at the top of this script" >&2
    echo "have to move together, and requirements-<abi>-linux.txt with them." >&2
    exit 2
  fi

  # The glibc gate. It belongs to this phase and not to the interpreter: the
  # standalone CPython build runs on far older hosts than the cryptography
  # wheel this file pins.
  if ! glibc_version="$(getconf GNU_LIBC_VERSION 2>/dev/null)"; then
    echo "no glibc on this host (musl?), and the wheels pinned in" >&2
    echo "$REQUIREMENTS are manylinux builds." >&2
    echo "Install cryptography for this libc yourself and pass --base naming that interpreter." >&2
    exit 2
  fi
  glibc_version="${glibc_version##* }"
  if [ "$(printf '%s\n%s\n' "$MIN_GLIBC" "$glibc_version" | sort -V | head -1)" != "$MIN_GLIBC" ]; then
    echo "glibc $glibc_version is older than $MIN_GLIBC." >&2
    echo "pip picks a cryptography wheel by glibc version, and $REQUIREMENTS" >&2
    echo "pins the manylinux_${MIN_GLIBC/./_} one. On this host pip would ask for the" >&2
    echo "manylinux_2_28 or _2_17 build instead, whose hash is not in that file, and" >&2
    echo "the install would fail as a hash mismatch rather than as this message." >&2
    echo "Install cryptography for this host yourself and pass --base naming that interpreter." >&2
    exit 2
  fi

  [ -f "$REQUIREMENTS" ] || { echo "no requirements file at $REQUIREMENTS" >&2; exit 2; }

  # The cache dir is shared: $HOME is a bind mount that several concurrent runs
  # see at once. One exclusive lock covers the install, so a second caller waits
  # here instead of writing over the first caller's download.
  mkdir -p "$CACHE"
  exec 9>"$CACHE/.install.lock"
  flock 9
  if [ "$force" = 1 ] || ! have_packages; then
    # Phase one, the only step that needs egress. --only-binary keeps pip from
    # building an sdist whose hash is not the wheel hash pinned here, so a
    # missing wheel says so instead of failing at the hash.
    if [ "$force" = 1 ] || [ ! -d "$WHEELHOUSE" ]; then
      wh_tmp="$(mktemp -d "${WHEELHOUSE}.XXXXXX")"
      trap 'rm -rf "$wh_tmp"' EXIT
      echo "fetching wheels into $WHEELHOUSE (~5 MB, needs network) ..." >&2
      PYTHONNOUSERSITE=1 "$PYTHON_BIN" -m pip download \
        --require-hashes --no-deps --only-binary=:all: --no-cache-dir \
        -d "$wh_tmp" -r "$REQUIREMENTS" >&2
      rm -rf "$WHEELHOUSE"
      mv "$wh_tmp" "$WHEELHOUSE"
      trap - EXIT
    fi

    # Phase two, with no index and no network. --target keeps the packages out
    # of the interpreter's own site-packages, so the pinned CPython stays as it
    # was unpacked and an operator-supplied one is never written into.
    site_tmp="$(mktemp -d "${SITE_DIR}.XXXXXX")"
    trap 'rm -rf "$site_tmp"' EXIT
    echo "installing wheels into $SITE_DIR ..." >&2
    PYTHONNOUSERSITE=1 "$PYTHON_BIN" -m pip install \
      --no-index --find-links "$WHEELHOUSE" --no-deps --no-cache-dir \
      --target "$site_tmp" -r "$REQUIREMENTS" >&2
    rm -rf "$SITE_DIR"
    mv "$site_tmp" "$SITE_DIR"
    trap - EXIT
    installed=1

    have_packages || { echo "cryptography still will not import from $SITE_DIR" >&2; exit 2; }
    # No other lane has to record which OpenSSL it runs on: the wheel bundles
    # its own, and it is a different build from the one the interpreter's `ssl`
    # links. This prints the one the lane's crypto actually runs on.
    PYTHONPATH="$SITE_DIR" PYTHONNOUSERSITE=1 "$PYTHON_BIN" -c 'import cryptography as c
from cryptography.hazmat.bindings._rust import openssl
print("cryptography %s, bundled %s" % (c.__version__, openssl.openssl_version_text()))' >&2
  fi
  exec 9>&-
fi

# Said on the reuse path too. The package dir is on neither PATH nor any
# default sys.path, so if the output does not name it, the next caller
# downloads the wheels again, or concludes they are not there.
if [ "$installed" != 1 ]; then
  if [ -n "$SITE_DIR" ]; then
    echo "packages already present at $SITE_DIR" >&2
  else
    echo "packages carried by $BASE itself" >&2
  fi
fi

printf '%s\n' "$SITE_DIR"
