#!/usr/bin/env bash
# Install a pinned CPython into a cache dir. Nothing system-wide, nothing in
# the checkout.
#
# Separated from check so the download can be done once, ahead of
# time, on a machine that has egress, and the run can then happen with no
# network at all. A binding's install-libraries calls this when the interpreter
# is missing, so calling it by hand is optional.
#
#   ./install-toolchain                    # install if absent, then print BASE
#   ./install-toolchain --version <token>  # the pin `versions` lists for <token>; default when absent
#   ./install-toolchain --base <dir>       # use this CPython as is, download nothing
#   ./install-toolchain --cache-root <dir> # put or find the install under this root
#   ./install-toolchain --print-base       # print where BASE is or would be, install nothing
#   ./install-toolchain --print-bin        # print the interpreter a caller drives, install nothing
#   ./install-toolchain --print-cache      # print this lane's cache dir, install nothing
#   ./install-toolchain --force            # re-download over an existing install
#   ./install-toolchain --help             # this text
#
# Run it directly: the shebang names bash.
#
# The version comes from --version, else DCA_VERSION, else `default`, the first
# default line of `versions` beside this script. A token that file does not
# list is refused with exit 2. Each version installs into a directory of its
# own, so two versions sit side by side in one cache.
#
# BASE is the unpacked CPython, with bin/python3 under it. A caller is given it,
# or the root the lanes live under; nothing here searches PATH and nothing here
# is put on PATH.
#
# --cache-root and --print-cache are one level apart, which is why the flag
# carries the word root: the root holds every lane and this lane's directory is
# `python` under it, so --print-cache answers <root>/python and feeding that
# back in as a root would install into python/python.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed CPython to use as is, nothing downloaded.
#                       --force is refused with it given: this script deletes only what it created.
#   --cache-root <dir>  root to install into, as <root>/python
#   $DCA_CACHE/python
#   $XDG_CACHE_HOME/dca/python
#   $HOME/.cache/dca/python
#
# This installs only the runtime. A binding's libraries, such as the
# cryptography wheels, are pinned and installed by that binding, under
# cryptography/ for example.
set -euo pipefail

# astral-sh/python-build-standalone tags releases by date and publishes a single
# SHA256SUMS asset covering the whole release; there are no per-asset .sha256
# files. Each token's CPython version is the second field of its line in
# `versions`, and its release tag and two hashes are below, keyed by token.
# Bumping a pin means changing the version there and the tag and both hashes
# here together, all four read off that one manifest:
#   https://github.com/astral-sh/python-build-standalone/releases/download/20260825/SHA256SUMS
pin_checksums() {
  case "$1" in
    3.14) PYTHON_RELEASE=20260825
          SHA256_x86_64=a0f39e822fd3b96a2605f30f954acf9a2cdf91faa1385a13e24bc407a41e05ea
          SHA256_aarch64=7f0b801b0ba2c74531cd2e66ee898569cdf1f323a24383576f2a6761001e01f1 ;;
    *) echo "versions lists $1, and this installer carries no checksum for it." >&2
       echo "Add the release tag and both hashes to pin_checksums before the token can install." >&2
       exit 2 ;;
  esac
}

# Which pinned build this host would take, resolved only where the answer is
# needed.
#
# An OS or an architecture the pin does not cover is a reason to refuse a
# download. It is not a reason to refuse --base, which is the flag an operator
# on such a host reaches for and which the refusals below tell them to pass, and
# it is not a reason to refuse --print-cache, which names a directory and knows
# nothing about builds. So this is a function, called where the pinned install
# is named, rather than a gate at the top of the
# file: run before the argument line is read, it answered every invocation on
# those hosts with the advice to pass a flag it had already made unreachable.
# The OS is tested here because the build below is a Linux build whatever this
# host is: without the refusal a Mac downloads it, passes the checksum, unpacks
# a Linux tree and dies on the first exec.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned build is a Linux CPython." >&2
       echo "Install CPython ${PYTHON_VERSION} by hand and pass --base" >&2
       echo "naming the directory holding it." >&2
       exit 2 ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  PARCH=x86_64 ;;
    aarch64|arm64) PARCH=aarch64 ;;
    *) echo "unsupported arch $(uname -m); install CPython ${PYTHON_VERSION}" >&2
       echo "by hand and pass --base" >&2
       exit 2 ;;
  esac
  sha_var="SHA256_${PARCH}"; WANT_SHA="${!sha_var}"

  TARBALL="cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-${PARCH}-unknown-linux-gnu-install_only_stripped.tar.gz"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The cache dir rule is defined once, in one file: DCA_CACHE, or the OS
# cache dir, or a refusal naming DCA_CACHE.
# shellcheck source=../_shared/cache.sh
. "$HERE/../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where BASE would be, and
# the print actions have to answer for the flags this invocation was given
# rather than for the defaults. Both path values are made absolute here, at the
# one place they are read; cache.sh explains why.
base=""
cache_root=""
print=""
force=0
version="${DCA_VERSION:-default}"
while [ $# -gt 0 ]; do
  case "$1" in
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding the interpreter" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the lanes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --version)
      [ $# -ge 2 ] || { echo "--version needs a token from $HERE/versions, or default" >&2; exit 2; }
      version="$2"; shift 2 ;;
    --print-base)  print=base; shift ;;
    --print-bin)   print=bin; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The version first: an unlisted token refuses every action, print queries
# included, so no caller is handed a path for a version nobody pinned.
resolve_version_pin "$HERE/versions" "$version" || exit 2
PYTHON_VERSION="$DCA_VERSION_RELEASE"
pin_checksums "$DCA_VERSION_TOKEN"

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/python"
else
  resolve_cache_dir python
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the lane name alone, so it answers
# first, ahead of everything that depends on the pin.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

if [ -n "$base" ]; then
  BASE="$base"
else
  pinned_platform
  BASE="$CACHE/cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}"
fi
PYTHON_BIN="$BASE/bin/python3"

# The other two queries answer and stop, before the install branch and
# before any directory is created. A caller that must not download asks one of
# these, and a cold cache root is still cold afterwards.
case "$print" in
  base)  printf '%s\n' "$BASE"; exit 0 ;;
  bin)   printf '%s\n' "$PYTHON_BIN"; exit 0 ;;
esac

# --force and --base name opposite things, and taken together this
# script deletes a directory it did not create: --force enters the interpreter
# branch even for a CPython that is already there and complete, and
# `rm -rf "$BASE"` below takes whatever --base pointed at.
# The pair is refused by name rather than the rm made conditional: an installer
# may delete what it created and nothing else.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned CPython over the install directory, and it starts by" >&2
  echo "deleting that directory. --base $base is a directory you pointed" >&2
  echo "this script at rather than one it created, so this run would delete yours. Refusing." >&2
  echo "Drop --base to re-download into the cache dir, or remove $base" >&2
  echo "yourself first if replacing it is what you meant." >&2
  exit 2
fi

# This block checks the directory --base names.
# The interpreter has to be there and run. Whether it carries a binding's
# libraries is that binding's question, asked by its install-libraries.
if [ -n "$base" ]; then
  if [ ! -x "$PYTHON_BIN" ]; then
    echo "--base $base has no bin/python3; point it at an installed CPython" >&2
    exit 2
  fi
  if ! "$PYTHON_BIN" -c 'pass' >/dev/null 2>&1; then
    echo "--base $base has a bin/python3 that will not run on this host" >&2
    exit 2
  fi
fi

# ---- the interpreter ---------------------------------------------------------

installed=0
if [ "$force" = 1 ] || [ ! -x "$PYTHON_BIN" ]; then
  mkdir -p "$CACHE"
  # The cache dir is shared: $HOME is a bind mount that several concurrent runs
  # see at once. One exclusive lock covers the whole install, so a second caller
  # waits here instead of writing over the first caller's download or reading a
  # tree that is still being unpacked.
  exec 9>"$CACHE/.install.lock"
  flock 9
  # Re-tested under the lock, because the caller that held it first may have
  # finished the install while this one waited. A --force run always installs.
  if [ "$force" = 1 ] || [ ! -x "$PYTHON_BIN" ]; then
    # Armed before either temp exists, so a failing `mktemp -d` cannot leave the
    # tarball temp file behind. `rm` on an empty name is a silent no-op, which is
    # what the trap sees when it fires before the second mktemp has answered.
    py_tar=""
    py_tmp=""
    trap 'rm -f "$py_tar"; rm -rf "$py_tmp"' EXIT
    py_tar="$(mktemp "$CACHE/.${TARBALL}.XXXXXX")"
    py_tmp="$(mktemp -d "${BASE}.XXXXXX")"
    echo "fetching $TARBALL (~36 MB, needs network) ..." >&2
    # Version-pinned release asset. `+` must stay percent-encoded as %2B, and
    # the releases/latest form is the one to avoid: it walks forward to the next
    # dated release and these checksums stop matching.
    curl -fSL --max-time 900 -o "$py_tar" \
      "https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/${TARBALL/+/%2B}"
    echo "${WANT_SHA}  $py_tar" | sha256sum -c - >&2
    tar -xzf "$py_tar" -C "$py_tmp" --strip-components=1
    rm -f "$py_tar"
    # The rename is the last step, so $BASE is either absent or a
    # complete install. Nobody outside the lock sees a half-unpacked tree.
    rm -rf "$BASE"
    mv "$py_tmp" "$BASE"
    trap - EXIT
    installed=1
    echo "installed to $BASE (~107 MB extracted)" >&2
    # Only on a fresh install. The reuse path says the paths and nothing else.
    "$PYTHON_BIN" -VV >&2
  fi
  exec 9>&-
fi

# Said on the reuse path too. The interpreter is on neither PATH nor any
# default path, so if the output does not name it, the next caller downloads it
# again, or concludes it is not there.
[ "$installed" = 1 ] || echo "already present at $BASE" >&2

printf '%s\n' "$BASE"
