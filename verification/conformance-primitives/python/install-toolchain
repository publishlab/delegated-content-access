#!/usr/bin/env bash
# Install a pinned CPython and the one wheel this lane needs into a cache dir.
# Nothing system-wide, nothing in the checkout.
#
# Separated from check so the download can be done once, ahead of
# time, on a machine that has egress, and the run can then happen with no
# network at all. The run script calls this when the interpreter or the packages
# are missing, so calling it by hand is optional.
#
#   ./install-toolchain                    # install if absent, then print BASE
#   ./install-toolchain --base <dir>       # use this CPython as is, download nothing
#   ./install-toolchain --cache-root <dir> # put or find the install under this root
#   ./install-toolchain --print-base       # print where BASE is or would be, install nothing
#   ./install-toolchain --print-bin        # print the interpreter a caller drives, install nothing
#   ./install-toolchain --print-site       # print the package dir the run puts on PYTHONPATH,
#                                          # and nothing at all under --base
#   ./install-toolchain --print-cache      # print this lane's cache dir, install nothing
#   ./install-toolchain --force            # re-download over an existing install
#   ./install-toolchain --help             # this text
#
# Run it directly: the shebang names bash.
#
# BASE is the unpacked CPython, with bin/python3 under it. A caller is given it,
# or the root the lanes live under; nothing here searches PATH and nothing here
# is put on PATH.
#
# --cache-root and --print-cache are one level apart, which is why the flag
# carries the word root: the root holds every lane and this lane's directory is
# `python` under it, so --print-cache answers <root>/python and feeding that
# back in as a root would install into python/python.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed CPython to use as is, nothing downloaded.
#                       --force is refused with it given: this script deletes only what it created.
#   --cache-root <dir>  root to install into, as <root>/python
#   $DCA_CACHE/python
#   $XDG_CACHE_HOME/dca/python
#   $HOME/.cache/dca/python
#
# This is the first lane that needs a library as well as a runtime, so there are
# two downloads and two pins. Both are verified; see the two blocks below and
# ./README.md for what a bump costs.
set -euo pipefail

# ---- pin 1: the interpreter --------------------------------------------------
#
# astral-sh/python-build-standalone tags releases by date and publishes a single
# SHA256SUMS asset covering the whole release; there are no per-asset .sha256
# files. Bumping the pin means changing the tag, the version and both hashes
# together, all four read off that one manifest:
#   https://github.com/astral-sh/python-build-standalone/releases/download/20260825/SHA256SUMS
PYTHON_RELEASE=20260825
PYTHON_VERSION=3.14.7
SHA256_x86_64=a0f39e822fd3b96a2605f30f954acf9a2cdf91faa1385a13e24bc407a41e05ea
SHA256_aarch64=7f0b801b0ba2c74531cd2e66ee898569cdf1f323a24383576f2a6761001e01f1

# ---- pin 2: the wheels -------------------------------------------------------
#
# requirements-<abi>-linux.txt beside this script carries one --hash line per
# wheel, both architectures in the one list, because pip takes several --hash
# lines per requirement and picks which wheel to ask for by the host tags. Two
# facts weld that file to the values here:
#
#   PYTHON_ABI_TAG  cffi ships no abi3 wheel, only cp314-cp314 and friends, so
#                   its hash is tied to the interpreter's minor version. An
#                   interpreter that is not 3.14 needs a different requirements
#                   file, and this script says so rather than failing on a hash.
#   MIN_GLIBC       --require-hashes pins the file, but pip still chooses which
#                   file to ask for, by glibc version. cryptography publishes
#                   manylinux_2_17 / _2_28 / _2_34 builds of one version; the
#                   hash here is the _2_34 one. On an older host pip would ask
#                   for a wheel this file does not name and the install would
#                   fail as a hash mismatch, which reads like a supply-chain
#                   alarm and is not one. The check below refuses first, by name.
PYTHON_ABI_TAG=cp314
MIN_GLIBC=2.34

# Which pinned build this host would take, resolved only where the answer is
# needed.
#
# An OS or an architecture the pin does not cover is a reason to refuse a
# download. It is not a reason to refuse --base, which is the flag an operator
# on such a host reaches for and which the refusals below tell them to pass, and
# it is not a reason to refuse --print-cache, which names a directory and knows
# nothing about builds. So this is a function, called where the pinned install
# and its pin-keyed package dir are named, rather than a gate at the top of the
# file: run before the argument line is read, it answered every invocation on
# those hosts with the advice to pass a flag it had already made unreachable.
# The OS is tested here because the build below is a Linux build whatever this
# host is: without the refusal a Mac downloads it, passes the checksum, unpacks
# a Linux tree and dies on the first exec.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned build is a Linux CPython." >&2
       echo "Install CPython ${PYTHON_VERSION} with cryptography by hand and pass --base" >&2
       echo "naming the directory holding it." >&2
       exit 2 ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  PARCH=x86_64 ;;
    aarch64|arm64) PARCH=aarch64 ;;
    *) echo "unsupported arch $(uname -m); install CPython ${PYTHON_VERSION} with" >&2
       echo "cryptography by hand and pass --base" >&2
       exit 2 ;;
  esac
  sha_var="SHA256_${PARCH}"; WANT_SHA="${!sha_var}"

  TARBALL="cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-${PARCH}-unknown-linux-gnu-install_only_stripped.tar.gz"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REQUIREMENTS="$HERE/requirements-${PYTHON_ABI_TAG}-linux.txt"

# The cache dir rule is defined once, in one file: DCA_CACHE, or the OS
# cache dir, or a refusal naming DCA_CACHE.
# shellcheck source=../_shared/cache.sh
. "$HERE/../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where BASE, the site dir and the wheelhouse would be, and
# the print actions have to answer for the flags this invocation was given
# rather than for the defaults. Both path values are made absolute here, at the
# one place they are read; cache.sh explains why.
base=""
cache_root=""
print=""
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding the interpreter" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the lanes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --print-base)  print=base; shift ;;
    --print-bin)   print=bin; shift ;;
    --print-site)  print=site; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/python"
else
  resolve_cache_dir python
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the lane name alone, so it answers
# first, ahead of everything that depends on the pin.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

# The packages this lane installs are keyed by ABI tag and arch, so two
# interpreters never share one site dir: a cp314 cffi build is unimportable
# under any other minor version. That keying is also why an interpreter handed
# in with --base has no site dir here. --base means this exact toolchain with
# nothing downloaded, the check below refuses one that cannot already import
# cryptography, and so a --base run reads the packages the operator installed
# beside their own interpreter. Putting the pinned directory on that run's
# PYTHONPATH would shadow them with an extension module built for a different
# CPython, and the import error that follows reads as a broken lane rather than
# as two toolchains mixed. --print-site therefore answers nothing for a --base
# run, and check builds PYTHONPATH from that answer.
if [ -n "$base" ]; then
  BASE="$base"
  SITE_DIR=""
  WHEELHOUSE=""
else
  pinned_platform
  BASE="$CACHE/cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}"
  SITE_DIR="$CACHE/site-${PYTHON_ABI_TAG}-${PARCH}"
  WHEELHOUSE="$CACHE/wheelhouse-${PYTHON_ABI_TAG}-${PARCH}"
fi
PYTHON_BIN="$BASE/bin/python3"

# The other three queries answer and stop, before either install branch and
# before any directory is created. A caller that must not download asks one of
# these, and a cold cache root is still cold afterwards.
case "$print" in
  base)  printf '%s\n' "$BASE"; exit 0 ;;
  bin)   printf '%s\n' "$PYTHON_BIN"; exit 0 ;;
  site)  printf '%s\n' "$SITE_DIR"; exit 0 ;;
esac

# --force and --base name opposite things, and taken together this
# script deletes a directory it did not create: --force enters the interpreter
# branch even for a CPython that is already there and complete, and
# `rm -rf "$BASE"` below takes whatever --base pointed at.
# The pair is refused by name rather than the rm made conditional: an installer
# may delete what it created and nothing else. The wheelhouse and the site dir
# are this script's own, both under the cache dir, and they belong to the pinned
# interpreter rather than to this run, so they are not what --force beside
# --base could have meant either.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned CPython over the install directory, and it starts by" >&2
  echo "deleting that directory. --base $base is a directory you pointed" >&2
  echo "this script at rather than one it created, so this run would delete yours. Refusing." >&2
  echo "Drop --base to re-download into the cache dir, or remove $base" >&2
  echo "yourself first if replacing it is what you meant." >&2
  echo "The pinned interpreter keeps its own packages in the site and wheelhouse directories" >&2
  echo "under $CACHE; removing those and re-running without --base rebuilds them." >&2
  exit 2
fi

# This block checks the directory --base names.
# The interpreter has to be there, run, and already import cryptography, because
# --base promises this exact toolchain with nothing downloaded and every check
# this lane runs goes through that library. An interpreter without it is refused
# here with the command that would fix it, rather than quietly turning --base
# into a wheel fetch.
if [ -n "$base" ]; then
  if [ ! -x "$PYTHON_BIN" ]; then
    echo "--base $base has no bin/python3; point it at an installed CPython" >&2
    exit 2
  fi
  if ! "$PYTHON_BIN" -c 'pass' >/dev/null 2>&1; then
    echo "--base $base has a bin/python3 that will not run on this host" >&2
    exit 2
  fi
  if ! PYTHONNOUSERSITE=1 "$PYTHON_BIN" -s -c 'import cryptography' >/dev/null 2>&1; then
    echo "--base $base cannot import cryptography, and every check this lane runs" >&2
    echo "goes through it. --base means this exact toolchain with nothing downloaded, so" >&2
    echo "this script will not fetch wheels into an interpreter you supplied. Install it" >&2
    echo "yourself with" >&2
    echo "  $PYTHON_BIN -m pip install -r $REQUIREMENTS" >&2
    echo "or drop --base and let this script install the pinned CPython and wheels." >&2
    exit 2
  fi
fi

# ---- the interpreter ---------------------------------------------------------

installed=0
if [ "$force" = 1 ] || [ ! -x "$PYTHON_BIN" ]; then
  mkdir -p "$CACHE"
  # The cache dir is shared: $HOME is a bind mount that several concurrent runs
  # see at once. One exclusive lock covers the whole install, so a second caller
  # waits here instead of writing over the first caller's download or reading a
  # tree that is still being unpacked.
  exec 9>"$CACHE/.install.lock"
  flock 9
  # Re-tested under the lock, because the caller that held it first may have
  # finished the install while this one waited. A --force run always installs.
  if [ "$force" = 1 ] || [ ! -x "$PYTHON_BIN" ]; then
    # Armed before either temp exists, so a failing `mktemp -d` cannot leave the
    # tarball temp file behind. `rm` on an empty name is a silent no-op, which is
    # what the trap sees when it fires before the second mktemp has answered.
    py_tar=""
    py_tmp=""
    trap 'rm -f "$py_tar"; rm -rf "$py_tmp"' EXIT
    py_tar="$(mktemp "$CACHE/.${TARBALL}.XXXXXX")"
    py_tmp="$(mktemp -d "${BASE}.XXXXXX")"
    echo "fetching $TARBALL (~36 MB, needs network) ..." >&2
    # Version-pinned release asset. `+` must stay percent-encoded as %2B, and
    # the releases/latest form is the one to avoid: it walks forward to the next
    # dated release and these checksums stop matching.
    curl -fSL --max-time 900 -o "$py_tar" \
      "https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/${TARBALL/+/%2B}"
    echo "${WANT_SHA}  $py_tar" | sha256sum -c - >&2
    tar -xzf "$py_tar" -C "$py_tmp" --strip-components=1
    rm -f "$py_tar"
    # The rename is the last step, so $BASE is either absent or a
    # complete install. Nobody outside the lock sees a half-unpacked tree.
    rm -rf "$BASE"
    mv "$py_tmp" "$BASE"
    trap - EXIT
    installed=1
    echo "installed to $BASE (~107 MB extracted)" >&2
    # Only on a fresh install. The reuse path says the paths and nothing else.
    "$PYTHON_BIN" -VV >&2
  fi
  exec 9>&-
fi

# ---- the wheels --------------------------------------------------------------
#
# Two phases on purpose, which is also the shape the JVM and .NET installers
# already have: fetch once where there is egress, install with none. The
# wheelhouse is this lane's cacheable artefact, the way the unpacked JDK is the
# JVM lane's.

# Asked of the interpreter that will run, with this lane's site dir on the path
# when there is one. A --base run has none, and the question is then whether the
# supplied interpreter imports cryptography on its own, which is the same
# question the --base check above already answered yes to.
have_packages() {
  if [ -n "$SITE_DIR" ]; then
    PYTHONPATH="$SITE_DIR" PYTHONNOUSERSITE=1 "$PYTHON_BIN" -c 'import cryptography' >/dev/null 2>&1
  else
    PYTHONNOUSERSITE=1 "$PYTHON_BIN" -c 'import cryptography' >/dev/null 2>&1
  fi
}

if [ "$force" = 1 ] || ! have_packages; then
  # Only the pinned interpreter reaches this branch, because --base refuses
  # above when it cannot import cryptography rather than fetching wheels into an
  # interpreter it was handed. The tag is still asserted, so a pin bumped in one
  # place and not the other says which two values disagree instead of failing on
  # a hash: the cffi wheel named in the requirements file is built for one
  # CPython minor version.
  actual_tag="$("$PYTHON_BIN" -c 'import sys; print("cp%d%d" % sys.version_info[:2])')"
  if [ "$actual_tag" != "$PYTHON_ABI_TAG" ]; then
    echo "$PYTHON_BIN is $actual_tag and the pinned wheels are $PYTHON_ABI_TAG." >&2
    echo "cffi publishes no abi3 wheel, so its hash is welded to the interpreter's" >&2
    echo "minor version and $REQUIREMENTS cannot install here." >&2
    echo "PYTHON_VERSION and PYTHON_ABI_TAG at the top of this script have to move" >&2
    echo "together, and requirements-<abi>-linux.txt with them." >&2
    exit 2
  fi

  # The glibc gate. It belongs to this phase and not to the interpreter: the
  # standalone CPython build runs on far older hosts than the cryptography
  # wheel this file pins.
  if ! glibc_version="$(getconf GNU_LIBC_VERSION 2>/dev/null)"; then
    echo "no glibc on this host (musl?), and the wheels pinned in" >&2
    echo "$REQUIREMENTS are manylinux builds." >&2
    echo "Install cryptography for this libc yourself and pass --base naming that interpreter." >&2
    exit 2
  fi
  glibc_version="${glibc_version##* }"
  if [ "$(printf '%s\n%s\n' "$MIN_GLIBC" "$glibc_version" | sort -V | head -1)" != "$MIN_GLIBC" ]; then
    echo "glibc $glibc_version is older than $MIN_GLIBC." >&2
    echo "pip picks a cryptography wheel by glibc version, and $REQUIREMENTS" >&2
    echo "pins the manylinux_${MIN_GLIBC/./_} one. On this host pip would ask for the" >&2
    echo "manylinux_2_28 or _2_17 build instead, whose hash is not in that file, and" >&2
    echo "the install would fail as a hash mismatch rather than as this message." >&2
    echo "Install cryptography for this host yourself and pass --base naming that interpreter." >&2
    exit 2
  fi

  [ -f "$REQUIREMENTS" ] || { echo "no requirements file at $REQUIREMENTS" >&2; exit 2; }

  mkdir -p "$CACHE"
  exec 9>"$CACHE/.install.lock"
  flock 9
  if [ "$force" = 1 ] || ! have_packages; then
    # Phase one, the only step that needs egress. --only-binary keeps pip from
    # building an sdist whose hash is not the wheel hash pinned here, so a
    # missing wheel says so instead of failing at the hash.
    if [ "$force" = 1 ] || [ ! -d "$WHEELHOUSE" ]; then
      wh_tmp="$(mktemp -d "${WHEELHOUSE}.XXXXXX")"
      trap 'rm -rf "$wh_tmp"' EXIT
      echo "fetching wheels into $WHEELHOUSE (~5 MB, needs network) ..." >&2
      PYTHONNOUSERSITE=1 "$PYTHON_BIN" -m pip download \
        --require-hashes --no-deps --only-binary=:all: --no-cache-dir \
        -d "$wh_tmp" -r "$REQUIREMENTS" >&2
      rm -rf "$WHEELHOUSE"
      mv "$wh_tmp" "$WHEELHOUSE"
      trap - EXIT
    fi

    # Phase two, with no index and no network. --target keeps the packages out
    # of the interpreter's own site-packages, so the pinned CPython stays as it
    # was unpacked and an operator-supplied one is never written into.
    site_tmp="$(mktemp -d "${SITE_DIR}.XXXXXX")"
    trap 'rm -rf "$site_tmp"' EXIT
    echo "installing wheels into $SITE_DIR ..." >&2
    PYTHONNOUSERSITE=1 "$PYTHON_BIN" -m pip install \
      --no-index --find-links "$WHEELHOUSE" --no-deps --no-cache-dir \
      --target "$site_tmp" -r "$REQUIREMENTS" >&2
    rm -rf "$SITE_DIR"
    mv "$site_tmp" "$SITE_DIR"
    trap - EXIT
    installed=1

    have_packages || { echo "cryptography still will not import from $SITE_DIR" >&2; exit 2; }
    # No other lane has to record which OpenSSL it runs on: the wheel bundles
    # its own, and it is a different build from the one the interpreter's `ssl`
    # links. This prints the one the lane's crypto actually runs on.
    PYTHONPATH="$SITE_DIR" PYTHONNOUSERSITE=1 "$PYTHON_BIN" -c 'import cryptography as c
from cryptography.hazmat.bindings._rust import openssl
print("cryptography %s, bundled %s" % (c.__version__, openssl.openssl_version_text()))' >&2
  fi
  exec 9>&-
fi

# Said on the reuse path too, and it names both halves: this lane installs an
# interpreter and a package dir, and neither is on PATH or on any default
# sys.path. If the output does not name them, the next caller downloads the toolchain again,
# or concludes it is not there. A --base run has only the one half to name.
if [ "$installed" != 1 ]; then
  if [ -n "$SITE_DIR" ]; then
    echo "already present at $BASE, packages at $SITE_DIR" >&2
  else
    echo "already present at $BASE, with the packages it carries itself" >&2
  fi
fi

printf '%s\n' "$BASE"
