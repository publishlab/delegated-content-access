#!/usr/bin/env bash
# Install a pinned Eclipse Temurin JDK into a cache dir. Nothing system-wide.
#
# Separated from check so the download can be done once, ahead
# of time, on a machine that has egress, and the run can then happen with no
# network at all. The run script calls this when the JDK is missing, so calling
# it by hand is optional.
#
#   ./install-toolchain                    # install if absent, then print BASE
#   ./install-toolchain --version <token>  # the pin `versions` lists for <token>; default when absent
#   ./install-toolchain --base <dir>       # use this JDK as is, fetch no JDK
#   ./install-toolchain --cache-root <dir> # put or find the JDK under this root
#   ./install-toolchain --print-base       # print where BASE is or would be, install nothing
#   ./install-toolchain --print-bin        # print the java binary a caller drives, install nothing
#   ./install-toolchain --print-cache      # print this lane's cache dir, install nothing
#   ./install-toolchain --force            # re-download over an existing install
#   ./install-toolchain --help             # this text
#
# Run it directly: the shebang names bash.
#
# The version comes from --version, else DCA_VERSION, else `default`, the first
# default line of `versions` beside this script. A token that file does not
# list is refused with exit 2. Each version installs into a directory of its
# own, so two versions sit side by side in one cache.
#
# BASE is the unpacked JDK: the directory JAVA_HOME names, with bin/java and
# bin/javac under it. --print-bin answers with bin/java because that is the
# binary a caller drives; the lane wrapper reaches bin/javac from BASE itself.
# Nothing here searches PATH and nothing here is put on PATH.
#
# This installs only the runtime. A binding's libraries, such as the Jackson
# jars, are pinned and installed by that binding, under jca-jackson/ for example.
#
# --cache-root and --print-cache are one level apart, which is why the flag
# carries the word root: the root holds every lane and this lane's directory is
# `jvm` under it, so --print-cache answers <root>/jvm and feeding that back in
# as a root would install into jvm/jvm.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed JDK to use as is, no JDK downloaded.
#                       --force is refused with it given: this script deletes only what it created.
#   --cache-root <dir>  root to install into, as <root>/jvm
#   $DCA_CACHE/jvm
#   $XDG_CACHE_HOME/dca/jvm
#   $HOME/.cache/dca/jvm
set -euo pipefail

# Pinned by release name, not by `latest`. The Adoptium `latest` endpoint moves
# to the next CPU the day it ships, and these checksums stop matching. Each
# token's release name is the second field of its line in `versions`, and its
# two checksums are below, keyed by token; the token is the feature release, so
# 21 is Temurin 21 LTS. Bumping a pin means changing the release there and both
# checksums here together, from the API:
#   https://api.adoptium.net/v3/assets/latest/21/hotspot?architecture=x64&image_type=jdk&os=linux&vendor=eclipse
pin_checksums() {
  case "$1" in
    21) SHA256_x64=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
        SHA256_aarch64=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223 ;;
    *) echo "versions lists $1, and this installer carries no checksum for it." >&2
       echo "Add both checksums for its release to pin_checksums before the token can install." >&2
       exit 2 ;;
  esac
  # The asset spells the same build with an underscore: jdk-21.0.12.1+1 -> 21.0.12.1_1
  ASSET_VERSION="$(printf '%s' "${JDK_RELEASE#jdk-}" | tr '+' '_')"
  JDK_FEATURE="$1"
}

# Which pinned asset this host would download, resolved on the leg that
# downloads one and nowhere else.
#
# An OS or an architecture the pin does not cover is a reason to refuse a
# download. It is not a reason to refuse --base, which is the flag an operator
# on such a host reaches for and which the refusals below tell them to pass, and
# it is not a reason to refuse the print queries, which name a path and install
# nothing. So this is a function the install branch calls rather than a gate at
# the top of the file: run before the argument line is read, it answered every
# invocation on those hosts with the advice to pass a flag it had already made
# unreachable. The OS is tested here because the asset below is a Linux build
# whatever this host is: without the refusal a Mac downloads it, passes the
# checksum, unpacks a Linux tree and dies on the first exec.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned asset is a Linux build." >&2
       echo "Install Temurin ${JDK_RELEASE} by hand and pass --base naming the directory holding it." >&2
       exit 2 ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  JARCH=x64 ;;
    aarch64|arm64) JARCH=aarch64 ;;
    *) echo "unsupported arch $(uname -m); install Temurin ${JDK_RELEASE} by hand and pass --base" >&2; exit 2 ;;
  esac
  sha_var="SHA256_${JARCH}"; WANT_SHA="${!sha_var}"
  TARBALL="OpenJDK${JDK_FEATURE}U-jdk_${JARCH}_linux_hotspot_${ASSET_VERSION}.tar.gz"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The cache dir rule is kept in one file, sourced here: DCA_CACHE, or the OS
# cache dir, or a refusal naming DCA_CACHE.
# shellcheck source=../_shared/cache.sh
. "$HERE/../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where BASE would be and the print actions have to answer
# for the flags this invocation was given rather than for the defaults. Both
# path values are made absolute here, at the one place they are read; cache.sh
# carries why.
base=""
cache_root=""
print=""
force=0
version="${DCA_VERSION:-default}"
while [ $# -gt 0 ]; do
  case "$1" in
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding the JDK" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the lanes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --version)
      [ $# -ge 2 ] || { echo "--version needs a token from $HERE/versions, or default" >&2; exit 2; }
      version="$2"; shift 2 ;;
    --print-base)  print=base; shift ;;
    --print-bin)   print=bin; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The version first: an unlisted token refuses every action, print queries
# included, so no caller is handed a path for a version nobody pinned.
resolve_version_pin "$HERE/versions" "$version" || exit 2
JDK_RELEASE="$DCA_VERSION_RELEASE"
pin_checksums "$DCA_VERSION_TOKEN"

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/jvm"
else
  resolve_cache_dir jvm
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the lane name alone, so it answers
# first, ahead of everything that depends on the pin.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

BASE="${base:-$CACHE/$JDK_RELEASE}"
JAVA_BIN="$BASE/bin/java"
JAVAC_BIN="$BASE/bin/javac"

# The other two queries answer and stop, before the install branch and before
# any directory is created. A caller that must not download asks one of these,
# and a cold cache root is still cold afterwards.
case "$print" in
  base)  printf '%s\n' "$BASE"; exit 0 ;;
  bin)   printf '%s\n' "$JAVA_BIN"; exit 0 ;;
esac

# --force and --base name opposite things, and taken together this script
# deletes a directory it did not create: --force enters the install branch even
# for a JDK that is already there and complete, and `rm -rf "$BASE"`
# below takes whatever --base pointed at. The pair is refused by name
# rather than the rm made conditional: an installer may delete what it created
# and nothing else.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned JDK over the install directory, and it starts by" >&2
  echo "deleting that directory. --base $base is a directory you pointed this" >&2
  echo "script at rather than one it created, so this run would delete yours. Refusing." >&2
  echo "Drop --base to re-download into the cache dir, or remove $base" >&2
  echo "yourself first if replacing it is what you meant." >&2
  exit 2
fi

# The directory --base names is checked here.
# The check asks for javac because the lane compiles, and a JRE would
# pass a check for java alone and then fail at the build.
if [ -n "$base" ]; then
  if [ ! -x "$JAVAC_BIN" ]; then
    echo "--base $base has no bin/javac; point it at a JDK, not a JRE" >&2
    exit 2
  fi
  if ! "$JAVA_BIN" -version >/dev/null 2>&1; then
    echo "--base $base has a bin/java that will not run on this host" >&2
    exit 2
  fi
fi

installed=0
if [ "$force" = 1 ] || [ ! -x "$JAVAC_BIN" ]; then
  # This branch downloads, so this is where the host has to be one the pin covers.
  pinned_platform
  mkdir -p "$CACHE"
  # The cache dir may be shared by several concurrent runs.
  # One exclusive lock covers the whole install, so a second caller
  # waits here instead of writing over the first caller's download or reading a
  # JDK directory that is still being unpacked.
  exec 9>"$CACHE/.install.lock"
  flock 9
  # Re-tested under the lock, because the caller that held it first may have
  # finished the install while this one waited. A --force run always installs.
  if [ "$force" = 1 ] || [ ! -x "$JAVAC_BIN" ]; then
    # Armed before either temp exists, so a failing `mktemp -d` cannot leave the
    # tarball temp file behind. `rm` on an empty name is a silent no-op, which is
    # what the trap sees when it fires before the second mktemp has answered.
    jdk_tar=""
    jdk_tmp=""
    trap 'rm -f "$jdk_tar"; rm -rf "$jdk_tmp"' EXIT
    jdk_tar="$(mktemp "$CACHE/.${TARBALL}.XXXXXX")"
    jdk_tmp="$(mktemp -d "${BASE}.XXXXXX")"
    echo "fetching $TARBALL (~198 MB, needs network) ..." >&2
    # Version-pinned Adoptium endpoint. It redirects to a short-lived signed asset
    # URL, so -L is required; + must stay percent-encoded as %2B.
    curl -fSL --max-time 900 -o "$jdk_tar" \
      "https://api.adoptium.net/v3/binary/version/${JDK_RELEASE/+/%2B}/linux/${JARCH}/jdk/hotspot/normal/eclipse"
    echo "${WANT_SHA}  $jdk_tar" | sha256sum -c - >&2
    tar -xzf "$jdk_tar" -C "$jdk_tmp" --strip-components=1
    rm -f "$jdk_tar"
    # The rename is the last step, so $BASE is either absent or a
    # complete JDK. Nobody outside the lock sees a half-unpacked tree.
    rm -rf "$BASE"
    mv "$jdk_tmp" "$BASE"
    trap - EXIT
    installed=1
    echo "installed to $BASE (~346 MB extracted)" >&2
    # Only on a fresh install. On the reuse path the script prints the path and nothing else.
    "$JAVA_BIN" -version >&2
  fi
  exec 9>&-
fi
# Printed on the reuse path too. If a JDK is off PATH and nobody can name it,
# the next caller downloads it again, or concludes it is not there.
[ "$installed" = 1 ] || echo "already present at $BASE" >&2

printf '%s\n' "$BASE"
