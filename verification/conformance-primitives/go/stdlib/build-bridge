#!/bin/sh
# Compile the operation bridge, before the batch clock starts.
#
#   ./build-bridge
#
# The runner names this as the Go lane's preparation step and runs it outside the
# request budget, so the budget then measures one already-built program
# answering one batch. It writes `v1/bridge/bridge` beside the source and prints
# nothing when the compile succeeds.
#
# This script asks for the toolchain, guesses nothing and downloads nothing.
# install-toolchain sets where Go lives and where this lane's cache is, and
# both are read off it rather than spelled again: a second copy of that path would be a
# second definition to keep in step. `--print-bin` and `--print-cache` answer and
# install nothing, so a cold cache stays cold and a run with no toolchain says so
# instead of pulling 70 MB inside a conformance run. Installing is a separate
# command an operator runs once.
#
# Nothing goes on PATH. GOTOOLCHAIN=local so a `go` line in a go.mod cannot send
# this build off to fetch a different Go than the one the installer verified, and
# GOCACHE and GOPATH point into the lane's cache so the build output lands there
# rather than in this host's home directory.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
installer="$here/../install-toolchain"

# DCA_VERSION is the token of ../versions the lane check selected for this run.
version=${DCA_VERSION:-default}
bin=$("$installer" --version "$version" --print-bin)
cache=$("$installer" --version "$version" --print-cache)

if [ ! -x "$bin" ]; then
  echo "no Go toolchain at $bin, so the bridge was not built." >&2
  echo "Install it once with: $installer" >&2
  exit 2
fi

export GOTOOLCHAIN=local
export GOCACHE="$cache/build" GOPATH="$cache/gopath"

cd "$here/v1/bridge"
exec "$bin" build -o bridge .
