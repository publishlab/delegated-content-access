#!/usr/bin/env bash
# Install a pinned workerd into a cache dir. Nothing system-wide.
#
# Separated from check so the download can be done once, ahead of time, on a
# machine that has egress, and the run can then happen with no network at all.
# A binding's check and its prepare step call this, so calling it by hand is
# optional.
#
#   ./install-toolchain                    # install if absent, then print BASE
#   ./install-toolchain --version <token>  # the pin `versions` lists for <token>; default when absent
#   ./install-toolchain --base <dir>       # use this workerd as is, download nothing
#   ./install-toolchain --cache-root <dir> # put or find the install under this root
#   ./install-toolchain --print-base       # print where BASE is or would be, install nothing
#   ./install-toolchain --print-bin        # print the workerd binary a caller drives, install nothing
#   ./install-toolchain --print-cache      # print this runtime's cache dir, install nothing
#   ./install-toolchain --force            # re-download over an existing install
#   ./install-toolchain --help             # this text
#
# Run it directly: the shebang names bash.
#
# The version comes from --version, else DCA_VERSION, else `default`, the first
# default line of `versions` beside this script. A token that file does not
# list is refused with exit 2. Each version installs into a directory of its
# own, so two workerd releases sit side by side in one cache.
#
# BASE is a directory holding the single `workerd` binary. A caller is given
# it, or the root the runtimes live under; nothing here searches PATH and
# nothing here is put on PATH. The JavaScript driver that runs the corpus keeps
# running on whatever runtime DCA_JS names; this installs the workerd that
# answers as a bridge.
#
# --cache-root and --print-cache are one level apart, which is why the flag
# carries the word root: the root holds every runtime and this runtime's
# directory is `workerd` under it, so --print-cache answers <root>/workerd and
# feeding that back in as a root would install into workerd/workerd.
#
# Where it lands, first match wins:
#   --base <dir>        an already-installed workerd to use as is, nothing downloaded.
#                       --force is refused with it given: this script deletes only what it created.
#   --cache-root <dir>  root to install into, as <root>/workerd
#   $DCA_CACHE/workerd
#   $XDG_CACHE_HOME/dca/workerd
#   $HOME/.cache/dca/workerd
set -euo pipefail

# Pinned by exact version: each token's release is the second field of its line
# in `versions`, and its checksum is below, keyed by token. Each value is the
# `digest` the GitHub release API reports for the asset, read on 2026-10-09:
#   https://api.github.com/repos/cloudflare/workerd/releases/tags/v<release>
# That digest is GitHub's own asset metadata. Cloudflare publishes no checksum
# file beside the asset, so this pin trusts GitHub's record of the upload.
# Bumping a pin means changing the release there and the checksum here
# together, and rechecking which BoringSSL the tag builds with and that the
# WebCrypto calls the binding README names still reach it. Only the Linux
# x86_64 build is pinned; workerd publishes arm64, macOS and Windows builds, and
# no run here has used them.
pin_checksums() {
  case "$1" in
    1) SHA256_x64=a7c6dab0b3c2336eff0296edb83e2aa45d412d6e86f2e3b9ff89b380d829a2ae ;;
    *) echo "versions lists $1, and this installer carries no checksum for it." >&2
       echo "Add the checksum for its release to pin_checksums before the token can install." >&2
       exit 2 ;;
  esac
}

# Which pinned asset this host would download, resolved on the leg that
# downloads one and nowhere else.
#
# An OS or an architecture the pin does not cover is a reason to refuse a
# download. It is not a reason to refuse --base, which is the flag an operator
# on such a host reaches for and which the refusals below tell them to pass, and
# it is not a reason to refuse the print queries, which name a path and install
# nothing. The OS is tested because the asset is a Linux build whatever this
# host is: a Mac would download it, pass the checksum and fail on the first
# exec.
pinned_platform() {
  case "$(uname -s)" in
    Linux) ;;
    *) echo "unsupported OS $(uname -s); the pinned asset is a Linux build." >&2
       echo "Install workerd ${WORKERD_VERSION} by hand and pass --base naming the directory of the binary." >&2
       exit 2 ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64) BARCH=x64 ;;
    *) echo "unsupported arch $(uname -m); this installer pins only the Linux x86_64 build of workerd." >&2
       echo "Install workerd ${WORKERD_VERSION} by hand and pass --base naming the directory of the binary." >&2
       exit 2 ;;
  esac
  sha_var="SHA256_${BARCH}"; WANT_SHA="${!sha_var}"
  # workerd names its x86_64 Linux asset `linux-64`, not `linux-x64`.
  GZFILE="workerd-linux-64.gz"
  URL="https://github.com/cloudflare/workerd/releases/download/v${WORKERD_VERSION}/$GZFILE"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The cache dir rule and the version list reader are written once, in the file
# sourced below.
# shellcheck source=../_shared/cache.sh
. "$HERE/../_shared/cache.sh"

# The whole argument line is read before anything is resolved, because
# --cache-root moves where BASE would be and the print actions have to answer
# for the flags this invocation was given rather than for the defaults. Both
# path values are made absolute here, at the one place they are read; cache.sh
# explains why.
base=""
cache_root=""
print=""
force=0
version="${DCA_VERSION:-default}"
while [ $# -gt 0 ]; do
  case "$1" in
    --version)
      [ $# -ge 2 ] || { echo "--version needs a token from $HERE/versions, or default" >&2; exit 2; }
      version="$2"; shift 2 ;;
    --base)
      [ $# -ge 2 ] || { echo "--base needs the directory holding the workerd binary" >&2; exit 2; }
      resolve_absolute_path "$2"; base="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --cache-root)
      [ $# -ge 2 ] || { echo "--cache-root needs a directory to hold the runtimes" >&2; exit 2; }
      resolve_absolute_path "$2"; cache_root="$DCA_ABSOLUTE_PATH"; shift 2 ;;
    --print-base)  print=base; shift ;;
    --print-bin)   print=bin; shift ;;
    --print-cache) print=cache; shift ;;
    --force)       force=1; shift ;;
    --help|-h)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The version first: an unlisted token refuses every action, print queries
# included, so no caller is handed a path for a version nobody pinned.
resolve_version_pin "$HERE/versions" "$version" || exit 2
WORKERD_VERSION="$DCA_VERSION_RELEASE"
pin_checksums "$DCA_VERSION_TOKEN"

if [ -n "$cache_root" ]; then
  CACHE="$cache_root/workerd"
else
  resolve_cache_dir workerd
  CACHE="$DCA_CACHE_DIR"
fi

# --print-cache answers from the root and the runtime name alone, so it answers
# first, ahead of everything that depends on the pin.
if [ "$print" = cache ]; then printf '%s\n' "$CACHE"; exit 0; fi

BASE="${base:-$CACHE/workerd-v${WORKERD_VERSION}}"
WORKERD_BIN="$BASE/workerd"

# The other two queries answer and stop, before the install branch and before
# any directory is created. A caller that must not download asks one of these,
# and a cold cache root is still cold afterwards.
case "$print" in
  base)  printf '%s\n' "$BASE"; exit 0 ;;
  bin)   printf '%s\n' "$WORKERD_BIN"; exit 0 ;;
esac

# --force and --base name opposite things, and taken together this script
# deletes a directory it did not create. The pair is refused by name rather
# than the rm made conditional: an installer may delete what it created and
# nothing else.
if [ -n "$base" ] && [ "$force" = 1 ]; then
  echo "--force re-downloads the pinned release over the install directory, and it starts by" >&2
  echo "deleting that directory. --base $base is a directory you pointed this" >&2
  echo "script at rather than one it created, so this run would delete yours. Refusing." >&2
  echo "Drop --base to re-download into the cache dir, or remove $base" >&2
  echo "yourself first if replacing it is what you meant." >&2
  exit 2
fi

# The binary --base names has to be there and also run: a build for another
# architecture answers -x and then fails the first batch, which reads as a
# broken bridge and is not one.
if [ -n "$base" ]; then
  if [ ! -x "$WORKERD_BIN" ]; then
    echo "--base $base has no executable workerd; point it at the directory holding the binary" >&2
    exit 2
  fi
  if ! "$WORKERD_BIN" --version >/dev/null 2>&1; then
    echo "--base $base has a workerd that will not run on this host" >&2
    exit 2
  fi
fi

installed=0
if [ "$force" = 1 ] || [ ! -x "$WORKERD_BIN" ]; then
  # This branch downloads, so this is where it checks that the pin covers the
  # host.
  pinned_platform
  command -v curl >/dev/null 2>&1 || {
    echo "no curl on PATH, and fetching $GZFILE is the one step here that needs it." >&2
    echo "Download $URL on a machine that has egress," >&2
    echo "gunzip it, chmod +x it, and pass --base naming the directory holding the workerd binary." >&2
    exit 2
  }
  command -v gzip >/dev/null 2>&1 || {
    echo "no gzip on PATH, and $GZFILE is a gzip of the bare binary." >&2
    echo "Unpack it by hand and pass --base naming the directory holding the workerd binary." >&2
    exit 2
  }
  mkdir -p "$CACHE"
  # The cache dir may be shared by several concurrent runs.
  # One exclusive lock covers the whole install, so a second caller
  # waits here instead of writing over the first caller's download or reading a
  # release that is still being unpacked.
  exec 9>"$CACHE/.install.lock"
  flock 9
  # Re-tested under the lock, because the caller that held it first may have
  # finished the install while this one waited. A --force run always installs.
  if [ "$force" = 1 ] || [ ! -x "$WORKERD_BIN" ]; then
    # Armed before either temp exists, so a failing `mktemp -d` cannot leave the
    # gzip temp file behind.
    workerd_gz=""
    workerd_tmp=""
    trap 'rm -f "$workerd_gz"; rm -rf "$workerd_tmp"' EXIT
    workerd_gz="$(mktemp "$CACHE/.${GZFILE}.XXXXXX")"
    workerd_tmp="$(mktemp -d "${BASE}.XXXXXX")"
    echo "fetching $GZFILE (~39 MB, needs network) ..." >&2
    if ! curl -fSL --max-time 600 -o "$workerd_gz" "$URL"; then
      echo "could not fetch $GZFILE. This is the only step here that needs egress; on a machine" >&2
      echo "with none, download it elsewhere, unpack it, and pass --base." >&2
      exit 2
    fi
    got_sha="$(sha256sum "$workerd_gz" | cut -d' ' -f1)"
    if [ "$got_sha" != "$WANT_SHA" ]; then
      echo "checksum mismatch on $GZFILE" >&2
      echo "  expected $WANT_SHA (GitHub release asset digest of v${WORKERD_VERSION})" >&2
      echo "  got      $got_sha" >&2
      exit 2
    fi
    echo "checksum verified: $GZFILE $got_sha" >&2
    # The asset is a gzip of the one binary, not an archive, so it unpacks to a
    # single file. The checksum covers the .gz, so the binary is never trusted
    # before the download it came from was.
    if ! gzip -dc "$workerd_gz" > "$workerd_tmp/workerd"; then
      echo "$GZFILE did not unpack as gzip." >&2
      exit 2
    fi
    rm -f "$workerd_gz"
    # The temp dir becomes BASE itself, and mktemp -d made it 0700.
    chmod 755 "$workerd_tmp"
    chmod +x "$workerd_tmp/workerd"
    # The proof runs on the unpacked binary before it is promoted, so a release
    # that will not start here is never promoted for the next caller to reuse.
    if ! "$workerd_tmp/workerd" --version >/dev/null 2>&1; then
      echo "$GZFILE unpacked and workerd will not run on this host." >&2
      echo "Install workerd ${WORKERD_VERSION} by hand and pass --base." >&2
      exit 2
    fi
    # The rename is the last step, so $BASE is either absent or a complete
    # install. Nobody outside the lock sees a half-written binary.
    rm -rf "$BASE"
    mv "$workerd_tmp" "$BASE"
    trap - EXIT
    installed=1
    echo "installed to $BASE" >&2
    echo "$("$WORKERD_BIN" --version)" >&2
  fi
  exec 9>&-
fi
# Said on the reuse path too. If nobody can name a runtime that is off PATH,
# the next caller downloads it again, or concludes it is not there.
[ "$installed" = 1 ] || echo "already present at $BASE" >&2

printf '%s\n' "$BASE"
