#!/usr/bin/env bash
# The launcher for the .NET probe: it resolves the pinned SDK the public .NET
# lane installs, publishes probe.csproj into that lane's cache, and runs the
# published program.
#
# The SDK is asked for, never guessed and never downloaded here.
# ../../../conformance-primitives/dotnet/install-toolchain manages the pin and the
# cache. It is called by relative path from this directory, with no flags on the
# first call so a cold cache installs, and it answers from any working directory
# because it reads its own location. Every scrap of SDK state stays inside that
# cache: without DOTNET_CLI_HOME and NUGET_PACKAGES the CLI writes to $HOME and
# the project writes bin/ and obj/ into the checkout.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER="$HERE/../../../conformance-primitives/dotnet/install-toolchain"

if [ ! -x "$INSTALLER" ]; then
  echo "probe: no installer at $INSTALLER, so no SDK could be resolved." >&2
  exit 2
fi

if ! BASE="$("$INSTALLER")" || [ ! -x "$BASE/dotnet" ]; then
  echo "probe: no .NET SDK; run $INSTALLER once on a machine with network." >&2
  exit 2
fi

CACHE="$("$INSTALLER" --print-cache)"
KEY="$(printf '%s' "$HERE" | sha256sum | cut -c1-16)"
BUILD="$CACHE/build/ecdh-envelope-size/$KEY"
mkdir -p "$BUILD"

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
export DOTNET_CLI_HOME="$CACHE/clihome"
export NUGET_PACKAGES="$CACHE/nuget"
export DOTNET_CLI_USE_MSBUILD_SERVER=0

# The cache dir is shared, and two runs from this same tree publish into this
# same directory, so one exclusive lock covers the publish. The publish command
# runs with fd 9 closed, so no build daemon it spawns can inherit the lock.
exec 9>"$BUILD/.build.lock"
flock 9

if ! "$BASE/dotnet" publish "$HERE/probe.csproj" \
    --artifacts-path "$BUILD/artifacts" \
    -o "$BUILD/app" \
    -p:UseSharedCompilation=false \
    --nologo -v quiet 9>&- >&2; then
  echo "probe: the .NET probe did not publish, so nothing was observed." >&2
  exit 2
fi

export DCA_EXPERIMENT_DIR="$(cd "$HERE/.." && pwd)"
exec "$BASE/dotnet" exec "$BUILD/app/probe.dll" "$@"
